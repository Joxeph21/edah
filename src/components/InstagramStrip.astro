---
// src/components/home/InstagramStrip.astro
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import SectionHeading from "./SectionHeading.astro";
import { Socials } from "@/constants/socials";

interface Props {
  handle?: string; 
  images?: ImageMetadata[]; 
}
const { handle = "edah.artist", images = [] } = Astro.props;
const url = Socials.find(el => el.label === "Instagram")?.link;
const slots = Array.from({ length: 6 }, (_, i) => images[i]);
---

<section
  class="mx-auto w-full max-w-6xl px-6 py-20 md:px-10 md:py-28"
  aria-labelledby="instagram-title"
  data-reveal-section
>
  <SectionHeading
    eyebrow={`@${handle}`}
    title="follow along"
    id="instagram-title"
  />

  <ul class="grid grid-cols-3 gap-3 md:grid-cols-6">
    {
      slots.map((img, i) => {
        const isLastEl = i === slots.length - 1;
        const isSecondLastEl = i === slots.length - 2;
        return (
          <li data-reveal>
            <a
              href={url}
              target="_blank"
              rel="noopener noreferrer"
              class={`group block aspect-square overflow-hidden rounded-xl bg-neutral-200 ${isLastEl ? 'opacity-20' : isSecondLastEl ? "opacity-50" : ""}`}
              aria-label={`Open Instagram, post ${i + 1} (opens in a new tab)`}
            >
              {img ? (
                <Image
                  src={img}
                  alt=""
                  width={400}
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
                />
              ) : (
                <div
                  class="h-full w-full transition-transform duration-500 group-hover:scale-110"
                  style={`background: hsl(${20 + i * 11} 22% ${80 - (i % 3) * 5}%)`}
                />
              )}
            </a>
          </li>
        );
      })
    }
  </ul>

  <div class="mt-10 flex justify-center" data-reveal>
    <a
      href={url}
      target="_blank"
      rel="noopener noreferrer"
      class="rounded-full border border-neutral-800 px-8 py-3 font-semibold transition-colors hover:bg-neutral-200"
    >
      Follow on Instagram
      <span class="sr-only"> (opens in a new tab)</span>
    </a>
  </div>
</section>

<script>
  import "@/lib/reveal";
</script>
