---
// src/components/home/FeaturedPieces.astro
import { Image } from "astro:assets";
import SectionHeading from "./SectionHeading.astro";
import ProductModal from "./ProductModal.astro";
import {
  PRODUCT_SELECT,
  toProduct,
  cardSummary,
  type Product,
} from "@/lib/shop";
import supabase from "@/lib/supabase";

interface Props {
  pieces?: Product[];
}

let { pieces } = Astro.props;

if (!pieces) {
  const { data, error } = await supabase
    .from("artworks")
    .select(PRODUCT_SELECT)
    .eq("is_published", true)
    .eq("is_featured", true)
    .order("created_at", { ascending: false })
    .order("sort_order", { referencedTable: "artwork_types" })
    .order("sort_order", { referencedTable: "artwork_types.artwork_variants" })
    .limit(4);

  if (error) console.error(`Failed to fetch Supabase data: ${error.message}`);
  pieces = (data ?? []).map(toProduct);
}
---

<section
  class="mx-auto w-full max-w-7xl px-6 py-20 md:px-10 md:py-28"
  aria-labelledby="featured-title"
  data-reveal-section
>
  <SectionHeading title="featured pieces" id="featured-title" />

  <ul class="grid sm:grid-cols-2 gap-5 lg:grid-cols-4 lg:gap-6">
    {
      pieces.map((piece, i) => {
        const summary = cardSummary(piece, "all");

        return (
          <li class="group flex flex-col gap-3" data-reveal>
            <div class="relative aspect-4/5 overflow-hidden rounded-2xl bg-neutral-200">
              <button
                type="button"
                data-open
                data-product-id={piece.id}
                aria-label={`View ${piece.title}`}
                class="block h-full w-full cursor-pointer"
              >
                {piece.images[0] ? (
                  <Image
                    width={600}
                    height={750}
                    widths={[400, 600, 900]}
                    sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
                    quality={75}
                    loading={i < 2 ? "eager" : "lazy"}
                    fetchpriority={i === 0 ? "high" : "auto"}
                    src={piece.images[0]}
                    alt={piece.title}
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                ) : (
                  <div
                    class="h-full w-full transition-transform duration-500 group-hover:scale-105"
                    style={`background: hsl(${20 + i * 14} 22% ${80 - (i % 3) * 5}%)`}
                  />
                )}
              </button>
              {summary.badge && (
                <span class="pointer-events-none absolute left-3 top-3 rounded-full bg-white/90 px-3 py-1 text-xs capitalize backdrop-blur">
                  {summary.badge}
                </span>
              )}
            </div>

            <div class="flex items-baseline justify-between gap-3">
              <div class="min-w-0">
                <h3 class="truncate font-architects-daughter text-lg tracking-wider">
                  {piece.title}
                </h3>
                <p class="text-xs capitalize text-neutral-500">
                  {summary.badge}
                </p>
              </div>
              <span class="font-biryani font-medium">{summary.price}</span>
            </div>

            <button
              type="button"
              data-open
              data-product-id={piece.id}
              class="w-full cursor-pointer rounded-full border border-primary px-4 py-2 text-sm font-semibold tracking-wider text-primary transition-colors hover:bg-primary hover:text-white active:scale-[0.98]"
            >
              Collect this artwork
            </button>
          </li>
        );
      })
    }
  </ul>

  <div class="mt-12 flex justify-center" data-reveal>
    <a
      href="/shop"
      class="rounded-full bg-primary px-8 py-3 font-semibold text-white transition-opacity hover:opacity-90"
    >
      View the whole collection
    </a>
  </div>
</section>

<ProductModal products={pieces} />

<script>
  import "@/lib/reveal";
</script>
