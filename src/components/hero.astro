---
// src/components/home/Hero.astro
import { Image } from "astro:assets";
import portrait from "@/assets/images/image-1.jpeg";

interface Props {
  eyebrow?: string;
  title?: string;
  text?: string;
}
const {
  eyebrow = "multidisciplinary fine artist · lagos, nigeria",
  title = "worlds of impossibilities",
  text = "Dream-like paintings of Black figures at rest among nature: art as sanctuary in a world that never slows down.",
} = Astro.props;
---

<section class="mx-auto w-full max-w-6xl px-6 pb-16 pt-10 md:px-10 md:pb-24 md:pt-16">
  <div class="grid items-center gap-10 md:grid-cols-[minmax(0,1fr)_minmax(0,24rem)] md:gap-16">
    <div class="text-center md:text-left">
      <p class="mb-5 text-xs uppercase tracking-[0.3em] text-neutral-500">
        {eyebrow}
      </p>
      <h1 class="text-5xl leading-tight tracking-widest text-[#6b5252] md:text-7xl">
        {title}
      </h1>
      <p class="mx-auto mt-8 max-w-prose text-lg leading-8 tracking-wide text-neutral-700 md:mx-0">
        {text}
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-4 md:justify-start">
        <a
          href="/shop"
          class="rounded-full bg-primary px-8 py-3 font-semibold text-white transition-opacity hover:opacity-90"
        >
          Browse the shop
        </a>
        <a
          href="/portfolio"
          class="rounded-full border border-neutral-800 px-8 py-3 font-semibold transition-colors hover:bg-neutral-200"
        >
          View the portfolio
        </a>
      </div>
    </div>

    <!-- White-background photo sits on a tinted panel (multiply hides the white) -->
    <figure class="mx-auto w-full max-w-sm md:max-w-none">
      <div class="aspect-[4/5] overflow-hidden rounded-3xl bg-[#e9e4da]">
        <Image
          src={portrait}
          alt="Edah wearing a handmade clay mask with large yellow eyes and a green hoodie"
          width={900}
          loading="eager"
          class="h-full w-full object-cover object-center mix-blend-multiply"
        />
      </div>
    </figure>
  </div>
</section>