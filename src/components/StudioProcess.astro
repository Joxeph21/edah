---
// src/components/home/StudioProcess.astro
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import SectionHeading from "./SectionHeading.astro";
import oil from "@/assets/images/oil-1.jpeg";
import mask1 from "@/assets/images/masks-1.jpeg";
import mask2 from "@/assets/images/masks-2.jpeg";
import sketch1 from "@/assets/images/sketch-1.webp";
import sketch2 from "@/assets/images/sketch-2.webp";
import sketch3 from "@/assets/images/sketch-3.webp";
import sketch4 from "@/assets/images/sketch-4.webp";
import mother from "@/assets/images/mother.jpeg"

interface Shot {
  images?: ImageMetadata[];
  alt: string;
  caption: string;
  interval?: number; // ms between slides
  offset?: number; // ms before this tile starts
}

interface Props {
  text?: string;
  shots?: [Shot, Shot, Shot];
}

const {
  text = "Every piece begins slowly: sketches, layered color, and masks built by hand. A look at how the work comes together.",
  shots = [
    { images: [oil], alt: "Painting in progress on the easel", caption: "Layering oils", interval: 7000, offset: 0 },
    { images: [mask1, mask2], alt: "Clay mask taking shape", caption: "Building the masks", interval: 5200, offset: 2200 },
    { images: [sketch1, sketch2, sketch3, sketch4], alt: "Sketchbook studies and color notes", caption: "Sketches & studies", interval: 4300, offset: 4000 },
    { images: [mother], alt: "Sketchbook studies and color notes", caption: "Sketches & studies", interval: 4300, offset: 4000 },
  ],
} = Astro.props;

const tint = ["hsl(24 22% 78%)", "hsl(34 22% 74%)", "hsl(44 20% 80%)", "hsl(14 20% 76%)"];
const origins = ["30% 40%", "70% 35%", "50% 70%", "40% 50%"];
---

<section
  class="mx-auto w-full max-w-6xl px-6 py-20 md:px-10 md:py-28"
  aria-labelledby="studio-title"
  data-reveal-section
>
  <SectionHeading eyebrow="behind the work" title="inside the studio" id="studio-title" />

  <p
    class="mx-auto -mt-4 mb-12 max-w-2xl text-center text-base leading-8 tracking-wide text-neutral-700"
    data-reveal
  >
    {text}
  </p>

  <div class="grid gap-5 md:h-[34rem] md:grid-cols-3 md:grid-rows-2">
    {
      shots.map((shot, i) => (
        <figure
          class:list={[
            "group relative min-h-64 overflow-hidden rounded-2xl bg-neutral-200",
            i === 0 && "md:row-span-2",
            i === 3 && "md:col-span-2",
          ]}
          data-reveal
          data-slideshow
          data-interval={shot.interval ?? 4000}
          data-offset={shot.offset ?? i * 2000}
        >
          {shot.images?.length ? (
            <div class="absolute inset-0 transition-transform duration-700 group-hover:scale-105">
              {shot.images.map((img, n) => (
                <Image
                  src={img}
                  alt={n === 0 ? shot.alt : ""}
                  width={900}
                  draggable="false"
                  data-slide
                  aria-hidden={n === 0 ? undefined : "true"}
                  style={`transform-origin: ${origins[i] ?? "50% 50%"}`}
                  class:list={[
                    "absolute inset-0 pointer-events-none select-none h-full w-full object-cover transition-opacity duration-[2000ms] ease-in-out will-change-transform",
                    n === 0 ? "opacity-100" : "opacity-0",
                  ]}
                />
              ))}
            </div>
          ) : (
            <div class="h-full w-full" style={`background: ${tint[i]}`} role="img" aria-label={shot.alt} />
          )}

          <!-- overlay -->
          <div
            class="pointer-events-none z-20 absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent"
            aria-hidden="true"
          />

          {/* <figcaption class="absolute z-30 top-4 left-4 rounded-full bg-white/85 px-4 py-1.5 text-xs tracking-wide text-neutral-800 backdrop-blur">
            {shot.caption}
          </figcaption> */}
        </figure>
      ))
    }
  </div>
</section>

<!-- <style>
  @keyframes kb-zoom {
    0%   { transform: scale(1); }
    50%  { transform: scale(1.4); }
    100% { transform: scale(1); }
  }
  [data-slide].kb-active {
    animation: kb-zoom var(--kb-duration, 6000ms) ease-in-out forwards;
  }
  [data-slide].kb-active.kb-loop {
    animation-iteration-count: infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-slide].kb-active { animation: none; }
  }
</style> -->

<script>
  import "@/lib/reveal";

  function initSlideshows() {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const FADE = 2000; // keep in sync with duration-[2000ms]

    document
      .querySelectorAll<HTMLElement>("[data-slideshow]:not([data-bound])")
      .forEach((el) => {
        el.dataset.bound = "true";
        if (reduceMotion) return;

        const slides = Array.from(el.querySelectorAll<HTMLElement>("[data-slide]"));
        if (!slides.length) return;

        const interval = Number(el.dataset.interval) || 4000;
        const offset = Number(el.dataset.offset) || 0;

        // one zoom cycle spans the visible time plus the fade-out
        el.style.setProperty("--kb-duration", `${interval + FADE}ms`);

        // single image: just zoom in and out forever
        if (slides.length < 2) {
          slides[0].style.animationDelay = `${offset}ms`;
          slides[0].classList.add("kb-active", "kb-loop");
          return;
        }

        let current = 0;
        slides[0].style.animationDelay = `${offset}ms`;
        slides[0].classList.add("kb-active");

        const show = (next: number) => {
          const prev = current;
          slides[prev].classList.replace("opacity-100", "opacity-0");
          slides[next].classList.replace("opacity-0", "opacity-100");
          slides[next].style.animationDelay = "0ms";
          slides[next].classList.add("kb-active");
          // let the outgoing slide keep zooming while it fades, then reset it
          setTimeout(() => slides[prev].classList.remove("kb-active"), FADE);
          current = next;
        };

        // staggered start so tiles don't all swap at once
        setTimeout(() => {
          setInterval(() => {
            if (!document.hidden) show((current + 1) % slides.length);
          }, interval);
        }, offset);
      });
  }

  initSlideshows();
  document.addEventListener("astro:page-load", initSlideshows);
</script>