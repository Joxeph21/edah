---
// src/components/home/StudioProcess.astro
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import SectionHeading from "./SectionHeading.astro";

interface Shot {
  src?: ImageMetadata;
  alt: string;
  caption: string;
}

interface Props {
  text?: string;
  shots?: [Shot, Shot, Shot];
}

const {
  text = "Every piece begins slowly: sketches, layered color, and masks built by hand. A look at how the work comes together.",
  shots = [
    { alt: "Painting in progress on the easel", caption: "Layering oils" },
    { alt: "Clay mask taking shape", caption: "Building the masks" },
    { alt: "Sketchbook studies and color notes", caption: "Sketches & studies" },
  ],
} = Astro.props;

const tint = ["hsl(24 22% 78%)", "hsl(34 22% 74%)", "hsl(44 20% 80%)"];
---

<section
  class="mx-auto w-full max-w-6xl px-6 py-20 md:px-10 md:py-28"
  aria-labelledby="studio-title"
  data-reveal-section
>
  <SectionHeading eyebrow="behind the work" title="inside the studio" id="studio-title" />

  <p
    class="mx-auto -mt-4 mb-12 max-w-2xl text-center text-base leading-8 tracking-wide text-neutral-700"
    data-reveal
  >
    {text}
  </p>

  <div class="grid gap-5 md:h-[34rem] md:grid-cols-3 md:grid-rows-2">
    {
      shots.map((shot, i) => (
        <figure
          class:list={[
            "group relative min-h-64 overflow-hidden rounded-2xl bg-neutral-200",
            i === 0 && "md:row-span-2",
          ]}
          data-reveal
        >
          {shot.src ? (
            <Image
              src={shot.src}
              alt={shot.alt}
              width={900}
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
          ) : (
            <div class="h-full w-full" style={`background: ${tint[i]}`} role="img" aria-label={shot.alt} />
          )}
          <figcaption class="absolute bottom-4 left-4 rounded-full bg-white/85 px-4 py-1.5 text-xs tracking-wide text-neutral-800 backdrop-blur">
            {shot.caption}
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>

<script>
  import "@/lib/reveal";
</script>
