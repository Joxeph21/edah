---
import Logo from "../../ui/Logo.astro";
import Navbar from "./Navbar.astro";
---

<header class="w-full z-10 bg-background sticky top-0 flex-between px-6 lg:px-10 py-10">
  <div class="flex items-center gap-3">
    <button
      id="mobile-nav"
      type="button"
      class="cursor-pointer flex items-center justify-center lg:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line class="hamburger-line" x1="4" y1="6" x2="20" y2="6"></line>
        <line class="hamburger-line" x1="4" y1="12" x2="20" y2="12"></line>
        <line class="hamburger-line" x1="4" y1="18" x2="20" y2="18"></line>
      </svg>
    </button>
    <Logo />
  </div>

  <Navbar />

  <div class="flex justify-end items-center gap-4 max-w-[20%] w-full">
    <a href="/cart" class="cursor-pointer flex-center gap-px" aria-label="Cart">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24px"
        height="24px"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path d="M0 0h24v24H0z" fill="none"></path>
        <g fill="none" stroke="currentColor">
          <circle cx="10" cy="19" r="1.5"></circle>
          <circle cx="17" cy="19" r="1.5"></circle>
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3.5 4h2l3.504 11H17"></path>
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M8.224 12.5L6.3 6.5h12.507a.5.5 0 0 1 .475.658l-1.667 5a.5.5 0 0 1-.474.342z"
          ></path>
        </g>
      </svg>

      <span data-cart-count>0</span>
    </a>
  </div>


  <div
    id="mobile-menu"
    inert
    class="lg:hidden fixed inset-x-0 z-50 overflow-y-auto bg-background px-6 pt-8 opacity-0 pointer-events-none transition-opacity duration-300 top-(--header-bottom,6.5rem) h-[calc(100dvh-var(--header-bottom,6.5rem))]"
  >
    <nav class="flex flex-col items-start gap-6">
      <a href="/shop" class="text-2xl font-architects-daughter tracking-wider hover:text-accent">Art Shop</a>
      <a href="/commisions" class="text-2xl font-architects-daughter tracking-wider hover:text-accent">Commissions</a>
      <a href="/portfolio" class="text-2xl font-architects-daughter tracking-wider hover:text-accent">Portfolio</a>
      <a href="/biography" class="text-2xl font-architects-daughter tracking-wider hover:text-accent">Bio</a>
      <a href="/resume" class="text-2xl font-architects-daughter tracking-wider hover:text-accent">CV</a>
      <a href="/contact" class="text-2xl font-architects-daughter tracking-wider hover:text-accent">Contact</a>
    </nav>
  </div>
</header>

<style>
  /*
    Each line must rotate around its OWN centre. SVG transforms default to
    the top-left of the whole <svg>, which is why the X looked wrong.
  */
  .hamburger-line {
    transform-box: fill-box;
    transform-origin: center;
    transition:
      transform 0.3s ease-out,
      opacity 0.2s ease-out;
  }

  /* Lines sit at y = 6 / 12 / 18, so the outer two travel 6 to reach the middle */
  #mobile-nav[aria-expanded="true"] .hamburger-line:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  #mobile-nav[aria-expanded="true"] .hamburger-line:nth-child(2) {
    opacity: 0;
  }
  #mobile-nav[aria-expanded="true"] .hamburger-line:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .hamburger-line {
      transition: none;
    }
  }
</style>

<script>
  import { syncCartBadges } from "@/lib/cart";

  // --- Cart badge ---
  syncCartBadges();
  window.addEventListener("storage", syncCartBadges);
  window.addEventListener("pageshow", syncCartBadges);
  document.addEventListener("astro:page-load", syncCartBadges);

  // --- Mobile menu ---
  const isOpen = () =>
    document.getElementById("mobile-nav")?.getAttribute("aria-expanded") ===
    "true";

  // Measure the header and expose it to CSS (used for the menu's top + height)
  function updateMenuOffset() {
    const header = document.getElementById("mobile-nav")?.closest("header");
    if (!header) return;
    // .bottom = distance from the viewport top to the header's bottom edge
    const { bottom } = header.getBoundingClientRect();
    document.documentElement.style.setProperty(
      "--header-bottom",
      `${Math.round(bottom)}px`
    );
  }

  function setMenu(open: boolean) {
    const btn = document.getElementById("mobile-nav");
    const menu = document.getElementById("mobile-menu");
    if (!btn || !menu || isOpen() === open) return;

    if (open) updateMenuOffset();

    btn.setAttribute("aria-expanded", String(open));
    menu.toggleAttribute("inert", !open); // keeps hidden links out of the tab order
    menu.classList.toggle("opacity-0", !open);
    menu.classList.toggle("pointer-events-none", !open);
    menu.classList.toggle("opacity-100", open);
    menu.classList.toggle("pointer-events-auto", open);
    document.documentElement.classList.toggle("overflow-hidden", open);
  }

  // Delegated listeners: they keep working even if the header is re-rendered
  document.addEventListener("click", (e) => {
    const target = e.target as Element;
    if (target.closest("#mobile-nav")) setMenu(!isOpen());
    else if (target.closest("#mobile-menu a")) setMenu(false);
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && isOpen()) {
      setMenu(false);
      document.getElementById("mobile-nav")?.focus();
    }
  });

  // Close if the window grows past the lg breakpoint
  window
    .matchMedia("(min-width: 1024px)")
    .addEventListener("change", (e) => e.matches && setMenu(false));

  // Keep the measurement correct when the header's height changes
  const observed = new WeakSet<Element>();
  function observeHeader() {
    const header = document.getElementById("mobile-nav")?.closest("header");
    if (!header || observed.has(header)) return;
    observed.add(header);
    new ResizeObserver(updateMenuOffset).observe(header);
    updateMenuOffset();
  }

  observeHeader();
  document.addEventListener("astro:page-load", () => {
    observeHeader();
    document.documentElement.classList.toggle("overflow-hidden", isOpen());
  });
</script>