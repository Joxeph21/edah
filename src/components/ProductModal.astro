---
// src/components/ProductModal.astro
import type { Product } from "@/lib/shop";

interface Props {
  products: Product[];
}
const { products } = Astro.props;

// Escape "<" so product text can never close the script tag
const json = JSON.stringify(products).replace(/</g, "\\u003c");
---

<script id="shop-data" type="application/json" is:inline set:html={json} />

<dialog
  id="product-modal"
  data-lenis-prevent
  aria-labelledby="pm-title"
  class="m-auto! max-h-[calc(100dvh-2rem)] w-[min(65rem,calc(100%-2rem))] overflow-hidden rounded-2xl bg-white p-0 text-neutral-900 open:flex open:flex-col relative backdrop:bg-black/50 backdrop:backdrop-blur-sm"
>
  <button
    type="button"
    data-close
    aria-label="Close"
    class="absolute right-3 top-3 z-10 grid size-10 cursor-pointer place-items-center rounded-full bg-white/60 text-2xl leading-none shadow transition hover:bg-white"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="1em"
      height="1em"
      viewBox="0 0 1024 1024"
    >
      <path d="M0 0h1024v1024H0z" fill="none"></path>
      <path
        fill="currentColor"
        fill-rule="evenodd"
        d="M799.855 166.312c.023.007.043.018.084.059l57.69 57.69c.041.041.052.06.059.084a.1.1 0 0 1 0 .069c-.007.023-.018.042-.059.083L569.926 512l287.703 287.703c.041.04.052.06.059.083a.12.12 0 0 1 0 .07c-.007.022-.018.042-.059.083l-57.69 57.69c-.041.041-.06.052-.084.059a.1.1 0 0 1-.069 0c-.023-.007-.042-.018-.083-.059L512 569.926L224.297 857.629c-.04.041-.06.052-.083.059a.12.12 0 0 1-.07 0c-.022-.007-.042-.018-.083-.059l-57.69-57.69c-.041-.041-.052-.06-.059-.084a.1.1 0 0 1 0-.069c.007-.023.018-.042.059-.083L454.073 512L166.371 224.297c-.041-.04-.052-.06-.059-.083a.12.12 0 0 1 0-.07c.007-.022.018-.042.059-.083l57.69-57.69c.041-.041.06-.052.084-.059a.1.1 0 0 1 .069 0c.023.007.042.018.083.059L512 454.073l287.703-287.702c.04-.041.06-.052.083-.059a.12.12 0 0 1 .07 0Z"
      ></path>
    </svg>
  </button>

  <div
    id="pm-scroll"
    class="min-h-0 md:max-h-[90vh] overflow-y-auto overscroll-contain"
  >
    <div class="grid  md:grid-cols-2">
      <!-- Gallery -->
    <!-- Gallery -->
<div class="bg-neutral-100 md:p-0">
  <div
    class="flex flex-col justify-center gap-3 p-4 md:sticky md:top-0 md:h-[min(90vh,calc(100dvh-2rem))]"
  >
    <div class="aspect-4/5 overflow-hidden rounded-xl bg-neutral-200">
      <img id="pm-image" alt="" class="h-full w-full object-contain" />
    </div>
    <div id="pm-thumbs" class="flex gap-2 overflow-x-auto"></div>
  </div>
</div>

      <!-- Details -->
      <div class="flex flex-col gap-5 p-6 sm:p-8">
        <span
          id="pm-badge"
          class="w-fit rounded-full bg-neutral-100 px-3 py-1 text-xs capitalize"
        ></span>

        <h2
          id="pm-title"
          class="font-architects-daughter text-3xl leading-tight tracking-wider"
        >
        </h2>

        <div
          id="pm-desc"
          class="font-light leading-relaxed tracking-wider text-neutral-600
         [&_p]:mb-4 [&_h3]:mb-2 [&_h3]:mt-6 [&_h3]:text-lg [&_h3]:font-medium [&_h3]:text-neutral-900
         [&_ul]:mb-4 [&_ul]:list-disc [&_ul]:space-y-1 [&_ul]:pl-5
         [&_strong]:font-medium [&_strong]:text-neutral-900
         [&_a]:text-primary [&_a]:underline [&_a]:underline-offset-4"
        >
        </div>

        <div id="pm-types-wrap">
          <p class="mb-2 text-sm font-medium tracking-wider">Format</p>
          <div
            id="pm-types"
            role="radiogroup"
            aria-label="Format"
            class="flex gap-1 rounded-lg bg-neutral-200 p-1"
          >
          </div>
        </div>

        <div
          id="pm-type-desc"
          class="text-sm font-light leading-7 tracking-wider text-neutral-600
         [&_p]:mb-3
         [&_h3]:mb-3 [&_h3]:mt-0 [&_h3]:text-xl [&_h3]:font-medium [&_h3]:text-neutral-900 [&_h3]:[font-family:inherit]
         [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-5
         [&_strong]:font-medium [&_strong]:text-neutral-900
         [&_a]:text-primary [&_a]:underline [&_a]:underline-offset-4"
        >
        </div>

        <div id="pm-variants-wrap">
          <p class="mb-2 text-sm font-medium tracking-wider">Option</p>
          <ul id="pm-variants" class="flex flex-wrap gap-2"></ul>
        </div>

        <div
          class="sticky bottom-0 -mx-6 -mb-6 mt-auto flex flex-col gap-4 border-t border-neutral-200 bg-white px-6 py-5 sm:-mx-8 sm:-mb-8 sm:px-8"
        >
          <div>
            <p id="pm-price" class="font-biryani text-2xl font-medium"></p>
            <p
              id="pm-stock"
              class="mt-1 text-sm tracking-wider text-neutral-500"
            >
            </p>
          </div>
          <div class="mt-auto border-t border-neutral-200 pt-5">
            <p id="pm-price" class="font-biryani text-2xl font-medium"></p>
            <p
              id="pm-stock"
              class="mt-1 text-sm tracking-wider text-neutral-500"
            >
            </p>
          </div>

          <!-- Not in the cart yet: the add button -->
          <button
            id="pm-add"
            type="button"
            class="w-full cursor-pointer rounded-lg bg-primary px-6 py-3 font-medium tracking-wider text-white transition hover:opacity-90 active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-50"
          >
            Collect this artwork
          </button>

          <!-- Already in the cart: a counter limited by stock -->
          <div id="pm-counter" hidden>
            <div class="flex items-center gap-4">
              <div
                class="inline-flex items-center rounded-full border border-neutral-300 bg-white"
              >
                <button
                  type="button"
                  data-qty-dec
                  aria-label="Decrease quantity"
                  class="h-11 w-11 cursor-pointer rounded-full text-xl transition-colors hover:bg-neutral-100"
                >
                  −
                </button>
                <span
                  id="pm-qty"
                  aria-live="polite"
                  class="w-10 text-center font-medium"></span>
                <button
                  id="pm-qty-inc"
                  type="button"
                  data-qty-inc
                  aria-label="Increase quantity"
                  class="h-11 w-11 cursor-pointer rounded-full text-xl transition-colors hover:bg-neutral-100 disabled:cursor-not-allowed disabled:opacity-30 disabled:hover:bg-transparent"
                >
                  +
                </button>
              </div>

              <div class="min-w-0">
                <p class="text-sm font-medium tracking-wider">In your cart</p>
                <p
                  id="pm-qty-note"
                  class="text-xs tracking-wider text-neutral-500"
                >
                </p>
              </div>
            </div>

            <a
              href="/cart"
              class="mt-3 inline-block text-sm tracking-wider text-primary underline underline-offset-4 transition-opacity hover:opacity-70"
            >
              View cart
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</dialog>

<script>
  import { animate } from "motion";
  import {
    formatPrice,
    stockLabel,
    startType,
    defaultVariant,
    type Product,
  } from "@/lib/shop";
  import { addToCart, getQty, setQty, maxQtyFor, MAX_QTY } from "@/lib/cart";

  // State for whichever modal is on the page right now
  let dialog: HTMLDialogElement | null = null;
  let products: Product[] = [];
  let product!: Product;
  let typeId = 0;
  let variantId: number | null = null;
  let imageIndex = 0;
  let closing = false;

  const $ = <T extends HTMLElement = HTMLElement>(id: string) =>
    dialog!.querySelector<T>(`#pm-${id}`)!;

  const lenis = () => (window as any).lenis;

  const esc = (s: string) =>
    s.replace(
      /[&<>"']/g,
      (c) =>
        ({
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#39;",
        })[c]!,
    );

  const currentType = () => product.types.find((t) => t.id === typeId)!;
  const currentVariant = () =>
    currentType().variants.find((v) => v.id === variantId) ?? null;

  function render() {
    const type = currentType();
    const variant = currentVariant();

    // Gallery
    const images = product.images.length
      ? product.images
      : ["/placeholder.svg"];
    const img = $<HTMLImageElement>("image");
    img.src = images[imageIndex];
    const frame = $("frame");
    img.onload = () => {
      const ratio = Math.min(
        Math.max(img.naturalWidth / img.naturalHeight, 0.6),
        1.8,
      );
      frame.style.aspectRatio = String(ratio);
    };
    img.alt = product.title;

    $("thumbs").innerHTML =
      images.length > 1
        ? images
            .map(
              (src, i) => `
        <button type="button" data-thumb="${i}" aria-label="Show image ${i + 1}"
          aria-current="${i === imageIndex}"
          class="size-16 shrink-0 cursor-pointer overflow-hidden rounded-lg border-2 border-transparent opacity-70 transition hover:opacity-100 aria-[current=true]:border-primary aria-[current=true]:opacity-100">
          <img src="${esc(src)}" alt="" class="h-full w-full object-cover" />
        </button>`,
            )
            .join("")
        : "";

    // Text (the badge follows the selected type's category)
    const badge = type.category?.label ?? "";
    $("badge").textContent = badge;
    $("badge").hidden = !badge;

    $("title").textContent = product.title;
    $("desc").innerHTML = product.description ?? "";
    $("desc").hidden = !product.description;

    // Type selector (only when there is a choice)
    $("types-wrap").hidden = product.types.length < 2;
    $("types").innerHTML = product.types
      .map(
        (t) => `
      <button type="button" role="radio" data-type="${t.id}" aria-checked="${t.id === typeId}"
        class="flex-1 cursor-pointer rounded-md px-3 py-2 text-sm tracking-wider transition aria-checked:bg-white aria-checked:font-semibold aria-checked:shadow-sm">
        ${esc(t.label)}
      </button>`,
      )
      .join("");

    $("type-desc").innerHTML = type.description ?? "";
    $("type-desc").hidden = !type.description;

    // Variant selector (only when there is a choice)
    $("variants-wrap").hidden = type.variants.length < 2;
    $("variants").innerHTML = type.variants
      .map(
        (v) => `
      <li>
        <button type="button" data-variant="${v.id}" aria-pressed="${v.id === variantId}"
          ${v.stock === 0 ? "disabled" : ""}
          class="cursor-pointer rounded-lg border border-neutral-300 px-4 py-2 text-sm tracking-wider transition hover:border-primary aria-pressed:border-primary aria-pressed:bg-primary aria-pressed:text-white disabled:cursor-not-allowed disabled:text-neutral-400 disabled:line-through disabled:hover:border-neutral-300">
          ${esc(v.label)}
        </button>
      </li>`,
      )
      .join("");

    // Price and stock
    const soldOut = !variant || variant.stock === 0;
    $("price").textContent = variant
      ? formatPrice(variant.price, variant.currency)
      : "Enquire";
    $("stock").textContent = variant ? stockLabel(variant.stock) : "";
    $("stock").classList.toggle("text-red-600", soldOut);

    // Add button, or a counter if this variant is already in the cart
    const inCart = variant ? getQty(variant.id) : 0;
    const add = $<HTMLButtonElement>("add");

    add.hidden = inCart > 0;
    add.disabled = soldOut;
    add.textContent = soldOut ? "Sold out" : "Collect this artwork";

    $("counter").hidden = inCart === 0;

    if (variant && inCart > 0) {
      const max = maxQtyFor(variant);
      const atLimit = inCart >= max;

      $("qty").textContent = String(inCart);
      $<HTMLButtonElement>("qty-inc").disabled = atLimit;
      $("qty-note").textContent = atLimit
        ? variant.stock < MAX_QTY
          ? "That's all that's available"
          : `Maximum ${MAX_QTY} per order`
        : "";
    }
  }

  function open(productId: number) {
    // No modal on this page, or it's already open
    if (!dialog || !dialog.isConnected || dialog.open) return;

    const p = products.find((x) => x.id === productId);
    if (!p) return;

    const filter =
      new URL(location.href).searchParams.get("filter")?.toLowerCase() ?? "all";
    const type = startType(p, filter);
    if (!type) return; // artwork has no types yet

    product = p;
    imageIndex = 0;
    typeId = type.id;
    variantId = defaultVariant(type)?.id ?? null;

    render();
    dialog.showModal();
    $("scroll").scrollTop = 0;
    document.documentElement.classList.add("overflow-hidden");
    lenis()?.stop();
    animate(dialog, { opacity: [0, 1], y: [16, 0] }, { duration: 0.25 });
  }

  async function closeModal() {
    const d = dialog;
    if (closing || !d || !d.open) return;
    closing = true;

    d.dataset.closing = "true";
    await animate(
      d,
      { opacity: [1, 0], y: [0, 16] },
      { duration: 0.2, ease: "easeIn" },
    );

    d.close();
    delete d.dataset.closing;
    closing = false;
  }

  // Finds this page's modal and wires it up (runs after every navigation)
  function setup() {
    const el = document.querySelector<HTMLDialogElement>("#product-modal");
    const dataEl = document.querySelector("#shop-data");

    if (!el || !dataEl) {
      dialog = null;
      return;
    }

    dialog = el;
    products = JSON.parse(dataEl.textContent ?? "[]");
    closing = false;

    // Listeners are already attached to this element
    if (el.dataset.ready) return;
    el.dataset.ready = "true";

    el.addEventListener("click", (e) => {
      const t = e.target as HTMLElement;

      if (t === el || t.closest("[data-close]")) return closeModal();

      const thumb = t.closest<HTMLElement>("[data-thumb]");
      if (thumb) {
        imageIndex = Number(thumb.dataset.thumb);
        return render();
      }

      const typeBtn = t.closest<HTMLElement>("[data-type]");
      if (typeBtn) {
        typeId = Number(typeBtn.dataset.type);
        variantId = defaultVariant(currentType())?.id ?? null;
        return render();
      }

      const variantBtn = t.closest<HTMLButtonElement>("[data-variant]");
      if (variantBtn && !variantBtn.disabled) {
        variantId = Number(variantBtn.dataset.variant);
        return render();
      }

      if (t.closest("#pm-add")) {
        const type = currentType();
        const variant = currentVariant();
        if (!variant || variant.stock === 0) return;

        addToCart({
          variantId: variant.id,
          sku: variant.sku,
          productId: product.id,
          title: product.title,
          typeLabel: type.label,
          variantLabel: variant.label,
          category: type.category?.label ?? "",
          price: variant.price,
          currency: variant.currency,
          image: product.images[0] ?? "/placeholder.svg",
          stock: variant.stock,
        });
        return render();
      }

      const inc = t.closest<HTMLButtonElement>("[data-qty-inc]");
      const dec = t.closest<HTMLButtonElement>("[data-qty-dec]");
      if ((inc && !inc.disabled) || dec) {
        const variant = currentVariant();
        if (!variant) return;
        setQty(variant.id, getQty(variant.id) + (inc ? 1 : -1));
        return render();
      }
    });

    el.addEventListener("cancel", (e) => {
      e.preventDefault();
      closeModal();
    });

    el.addEventListener("close", () => {
      document.documentElement.classList.remove("overflow-hidden");
      lenis()?.start();
    });
  }

  // Registered once; always uses the modal that is on the page right now
  document.addEventListener("click", (e) => {
    const trigger = (e.target as HTMLElement).closest<HTMLElement>(
      "[data-open]",
    );
    if (trigger) open(Number(trigger.dataset.productId));
  });

  // The page is about to be replaced: never leave the scroll locked
  document.addEventListener("astro:before-swap", () => {
    if (dialog?.open) dialog.close();
    document.documentElement.classList.remove("overflow-hidden");
    lenis()?.start();
    closing = false;
    dialog = null;
  });

  setup();
  document.addEventListener("astro:page-load", setup);
</script>

<style>
  #product-modal::backdrop {
    transition: opacity 0.2s ease;
  }
  #product-modal[data-closing]::backdrop {
    opacity: 0;
  }
  #product-modal[open]::backdrop {
    animation: backdrop-in 0.25s ease;
  }
  @keyframes backdrop-in {
    from {
      opacity: 0;
    }
  }
</style>
