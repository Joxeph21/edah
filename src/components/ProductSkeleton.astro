---
// src/components/ProductSkeleton.astro
interface Props {
  count?: number;
}
const { count = 4 } = Astro.props;
---

<ul class="grid sm:grid-cols-2 gap-5 lg:grid-cols-4 lg:gap-6" aria-hidden="true" aria-label="Loading featured pieces">
  {Array.from({ length: count }).map((_, i) => (
    <li class="group flex flex-col gap-3 animate-pulse">
      <div class="relative aspect-4/5 overflow-hidden rounded-2xl bg-neutral-200">
        <div class="absolute inset-0 bg-gradient-to-r from-neutral-200 via-neutral-300 to-neutral-200 bg-[length:200%_100%] animate-shimmer" />
      </div>

      <div class="flex items-baseline justify-between gap-3">
        <div class="min-w-0">
          <div class="h-6 w-3/4 bg-neutral-300 rounded font-architects-daughter" />
          <div class="mt-2 h-4 w-1/3 bg-neutral-300 rounded" />
        </div>
        <div class="h-7 w-20 bg-neutral-300 rounded font-biryani" />
      </div>

      <div class="h-12 w-full bg-neutral-300 rounded-full" />
    </li>
  ))}
</ul>

<style>
  @keyframes shimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }
  .animate-shimmer { animation: shimmer 1.5s infinite; }
</style>