---
// src/components/home/Newsletter.astro
interface Props {
  /** Your form endpoint (Formspree, Buttondown, Mailchimp, etc.) */
  action?: string;
}
const { action = "/api/newsletter" } = Astro.props;
---

<section
  class="mx-auto w-full max-w-6xl px-6 md:px-10"
  aria-labelledby="newsletter-title"
  data-reveal-section
>
  <div class="rounded-3xl bg-neutral-100 px-6 py-14 text-center md:px-16">
    <p
      class="mb-3 text-xs uppercase tracking-[0.3em] text-neutral-500"
      data-reveal
    >
      stay in the loop
    </p>
    <h2
      id="newsletter-title"
      class="text-4xl tracking-widest text-[#6b5252] md:text-5xl"
      data-reveal
    >
      let’s be email buddies…
    </h2>
    <p
      class="mx-auto mt-5 max-w-xl text-base leading-8 tracking-wide text-neutral-700"
      data-reveal
    >
      Get occasional studio updates and exclusive early access to new art
      releases by joining the Collector’s Club newsletter. No spam - just honest
      and heartfelt e-letters from one curious soul to another.
    </p>

    <form
      data-newsletter
      action={action}
      method="POST"
      novalidate
      class="mx-auto mt-8 flex max-w-md flex-col gap-3 sm:flex-row sm:items-start"
      data-reveal
    >
      <div class="w-full flex-1 text-left">
        <label for="newsletter-email" class="sr-only">Email address</label>
        <input
          id="newsletter-email"
          name="email"
          type="email"
          required
          autocomplete="email"
          placeholder="you@example.com"
          aria-describedby="newsletter-email-error"
          class="w-full rounded-full border border-neutral-300 bg-white px-6 py-3 outline-none focus-visible:ring-2 focus-visible:ring-[#6b5252]/50 aria-invalid:border-red-500 aria-invalid:focus-visible:ring-red-500/40"
        />
        <p
          id="newsletter-email-error"
          data-newsletter-error
          aria-live="polite"
          class="mt-1.5 px-6 text-sm tracking-wide text-red-600"
          hidden
        >
        </p>
      </div>

      <!-- Honeypot: real visitors never see or fill this -->
      <input
        type="text"
        name="website"
        tabindex="-1"
        autocomplete="off"
        class="hidden"
        aria-hidden="true"
      />
      <button
        type="submit"
        class="rounded-full bg-primary px-8 py-3 font-semibold text-white transition-opacity enabled:hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-50"
      >
        Subscribe
      </button>
    </form>
  </div>
</section>

<script>
  import "@/lib/reveal";
  import { toast } from "@/lib/toast";
  import { newsletterSchema } from "schemas/newsletterSchema";

  function init() {
    document
      .querySelectorAll<HTMLFormElement>("[data-newsletter]:not([data-bound])")
      .forEach((form) => {
        form.dataset.bound = "true";

        const input = form.querySelector<HTMLInputElement>("input[name=email]")!;
        const errorEl = form.querySelector<HTMLElement>("[data-newsletter-error]")!;
        const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;

        let touched = false;
        let sending = false;

        function setError(message?: string) {
          if (message) {
            input.setAttribute("aria-invalid", "true");
            errorEl.textContent = message;
            errorEl.hidden = false;
          } else {
            input.removeAttribute("aria-invalid");
            errorEl.textContent = "";
            errorEl.hidden = true;
          }
        }

        function validate(): boolean {
          const result = newsletterSchema.shape.email.safeParse(input.value);
          setError(result.success ? undefined : result.error.issues[0].message);
          return result.success;
        }

        // Silent check: no message, just drives the button
        function updateSubmitState() {
          const valid = newsletterSchema.shape.email.safeParse(input.value).success;
          button.disabled = sending || !valid;
        }

        // Validate when the user leaves the field, then live while typing
        input.addEventListener("blur", () => {
          touched = true;
          validate();
        });
        input.addEventListener("input", () => {
          if (touched) validate();
          updateSubmitState();
        });
        input.addEventListener("change", updateSubmitState); // some autofill

        form.addEventListener("submit", async (e) => {
          e.preventDefault();

          touched = true;
          if (!validate()) {
            input.focus();
            return;
          }

          const data = new FormData(form);
          if (data.get("website")) return; // honeypot tripped

          sending = true;
          updateSubmitState();

          try {
            if (form.getAttribute("action")) {
              const res = await fetch(form.action, {
                method: "POST",
                body: data,
                headers: { Accept: "application/json" },
              });
              if (!res.ok) throw new Error(String(res.status));
              toast.success("Thank you, you're on the list.");
            } else {
              console.warn("Newsletter: no `action` set, nothing was sent.");
              toast.error("Something went wrong");
            }
            form.reset();
            touched = false;
            setError();
          } catch {
            toast.error("Something went wrong. Please try again.");
          } finally {
            sending = false;
            updateSubmitState();
          }
        });

        updateSubmitState();
        window.addEventListener("pageshow", updateSubmitState);
      });
  }

  init();
  document.addEventListener("astro:page-load", init);
</script>