---
import Layout from "@/layouts/Layout.astro";
import bgIMG from "@/assets/slides/slide-3.webp";
import bgIMG2 from "@/assets/images/sanctuary.webp";
import bgIMG3 from "@/assets/images/mask.webp";
import { Image } from "astro:assets";

const data_tags = [
  { label: "paintings", image: bgIMG },
  { label: "sculptures", image: bgIMG2 },
  { label: "masks", image: bgIMG3 },
];
---

<Layout
  title="Portfolio"
  description="Explore Edah's portfolio of paintings, sculptures, and masks. Fusing magical realism with Afro-surrealism, each piece explores themes of lost innocence, otherworldliness, and the longing to escape modern constraints."
  type="website"
  tags={["art portfolio", "paintings", "sculptures", "masks", "magical realism", "afro-surrealism"]}
>
  <section
    class="w-full py-10 pb-15 lg:pb-20 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-20 lg:px-10 px-8"
  >
    {
      data_tags.map((tag) => (
        <a
          href={`portfolio/${tag.label}`}
          class="flex-center relative text-center capitalize rounded-lg aspect-square tracking-wider group overflow-hidden md:text-4xl text-2xl  text-white"
        >
          <Image
            class="w-full group-hover:scale-105 ease-in duration-200 transition-all absolute h-full object-center object-cover"
            src={tag.image}
            alt={tag.label}
          />
          <div class="absolute z-1 inset-0 w-full h-full bg-black/50" />
          <span
            class="relative
         font-bold
           [-webkit-text-stroke:1px_black] 
           z-2"
          >
            {tag.label}
          </span>
        </a>
      ))
    }
  </section>
</Layout>

