---
// src/pages/checkout.astro
import Layout from "@/layouts/Layout.astro";
import Receipt from "@/components/receipt.astro";

import countries from "@/data/countries.json";

const inputClass =
  "w-full rounded-lg border border-neutral-300 bg-white px-4 py-3 text-sm tracking-wider outline-none transition placeholder:text-neutral-400 focus:border-primary focus:ring-2 focus:ring-primary/10 aria-invalid:border-red-500 aria-invalid:focus:border-red-500 aria-invalid:focus:ring-red-500/20";
const labelClass = "mb-2 block text-sm font-medium tracking-wider";
---

<Layout
  title="Checkout"
  description="Complete your purchase of original artwork by Edah. Secure checkout with worldwide shipping. Enter delivery details and proceed to payment."
  type="website"
  tags={["checkout", "buy art online", "secure payment", "art shipping"]}
  noIndex={true}
  noFollow={true}
>
  <section class="content mt-20 px-6 pb-20 md:px-10 min-h-[calc(100vh-20rem)]">
    <header class="mb-10 flex flex-col gap-2">
      <h1 class="text-5xl tracking-widest text-[#6b5252] md:text-6xl">
        checkout
      </h1>
      <p class="my-4 tracking-wide text-neutral-500">
        Tell us where to send your artwork.
      </p>
    </header>

    <!-- Checkout (shown once the cart has items) -->
    <div id="checkout-layout" class="hidden">
      <div
        class="items-start gap-10 lg:grid lg:grid-cols-[minmax(0,1fr)_24rem]"
      >
        <!-- Delivery form -->
        <form
          id="checkout-form"
          action="#"
          method="POST"
          class="flex min-w-0 flex-col gap-10"
        >
          <fieldset class="flex flex-col gap-6">
            <legend
              class="font-architects-daughter mb-2 text-2xl tracking-wider"
            >
              contact
            </legend>

            <div>
              <label for="name" class={labelClass}>Full name</label>
              <input
                id="name"
                name="name"
                type="text"
                autocomplete="name"
                required
                class={inputClass}
              />
            </div>

            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
              <div>
                <label for="email" class={labelClass}>Email</label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  required
                  class={inputClass}
                />
              </div>
              <div>
                <label for="phone" class={labelClass}>
                  Phone (include country code)
                </label>
                <input
                  id="phone"
                  name="phone"
                  type="tel"
                  autocomplete="tel"
                  required
                  class={inputClass}
                />
              </div>
            </div>
          </fieldset>

          <fieldset class="flex flex-col gap-6">
            <legend
              class="font-architects-daughter mb-2 text-2xl tracking-wider"
            >
              delivery address
            </legend>

            <div>
              <label for="line1" class={labelClass}>Address</label>
              <input
                id="line1"
                name="line1"
                type="text"
                autocomplete="address-line1"
                required
                class={inputClass}
              />
            </div>

            <div>
              <label for="line2" class={labelClass}>
                Apartment, landmark, etc. (optional)
              </label>
              <input
                id="line2"
                name="line2"
                type="text"
                autocomplete="address-line2"
                class={inputClass}
              />
            </div>

            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
              <div>
                <label for="country" class={labelClass}>Country</label>
                <div class="relative">
                  <select
                    id="country"
                    name="country"
                    autocomplete="country"
                    required
                    class={`${inputClass} appearance-none pr-10 invalid:text-neutral-400`}
                  >
                    <option value="" disabled selected>
                      Select a country
                    </option>
                    {
                      countries.map((c) => (
                        <option value={c.code} class="text-neutral-900">
                          {c.name}
                        </option>
                      ))
                    }
                  </select>
                  <svg
                    class="pointer-events-none absolute top-1/2 right-4 h-4 w-4 -translate-y-1/2 text-neutral-500"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.17l3.71-3.94a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z"
                      clip-rule="evenodd"></path>
                  </svg>
                </div>
              </div>
              <div>
                <label for="city" class={labelClass}>City</label>
                <input
                  id="city"
                  name="city"
                  type="text"
                  autocomplete="address-level2"
                  required
                  class={inputClass}
                />
              </div>
            </div>

            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
              <div>
                <label for="state" class={labelClass}>State / region</label>
                <input
                  id="state"
                  name="state"
                  type="text"
                  autocomplete="address-level1"
                  required
                  class={inputClass}
                />
              </div>
              <div>
                <label for="postalCode" class={labelClass}>
                  Postal code (optional)
                </label>
                <input
                  id="postalCode"
                  name="postalCode"
                  type="text"
                  autocomplete="postal-code"
                  class={inputClass}
                />
              </div>
            </div>

            <div>
              <label for="notes" class={labelClass}>
                Delivery notes (optional)
              </label>
              <textarea
                id="notes"
                name="notes"
                rows="3"
                placeholder="Gate code, best time to call, anything we should know."
                class={`${inputClass} resize-none`}></textarea>
            </div>
          </fieldset>

          <div>
            <button
              type="submit"
              class="w-full cursor-pointer rounded-full bg-primary px-6 py-3 font-semibold text-white transition enabled:hover:opacity-90 enabled:active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-60 sm:w-fit sm:px-12"
            >
              Proceed to payment
            </button>
            <a
              href="/cart"
              class="mt-3 block text-sm tracking-wider text-neutral-600 underline underline-offset-4 transition-opacity hover:opacity-70 sm:mt-0 sm:ml-6 sm:inline-block"
            >
              Back to cart
            </a>
          </div>
        </form>

        <!-- Receipt -->
        <aside
          class="mx-auto mt-10 w-full max-w-md lg:sticky lg:top-40 lg:mx-0 lg:mt-0 lg:max-w-none lg:self-start"
        >
          <Receipt shippingLabel="to be confirmed" />
        </aside>
      </div>
    </div>

    <!-- Empty cart -->
    <div id="checkout-empty" class="hidden">
      <div
        class="flex flex-col items-center gap-6 rounded-xl bg-neutral-100 px-6 py-20 text-center"
      >
        <h2 class="text-3xl tracking-widest text-[#6b5252]">
          nothing to check out
        </h2>
        <p class="max-w-md tracking-wide text-neutral-600">
          Your cart is empty. Add a piece you love and come back.
        </p>
        <a
          href="/shop"
          class="rounded-full bg-primary px-8 py-3 font-semibold text-white transition-opacity hover:opacity-90"
        >
          Browse the shop
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { getCart } from "@/lib/cart";
  import { renderReceipt } from "@/lib/receipt";
  import countries from "@/data/countries.json";
  import { checkoutSchema, toE164 } from "schemas/checkoutSchema";
  import { toast } from "@/lib/toast";
  import type { CheckoutRequest } from "@/pages/api/checkout";

  type Field = HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;
  type FieldName = keyof typeof checkoutSchema.shape;

  const findCountry = (code: string) => countries.find((c) => c.code === code);

  const feeFor = (code: string) => {
    const country = findCountry(code);
    return country ? Number(country.shipping_fee) : undefined;
  };

  function init() {
    const layout = document.querySelector<HTMLElement>("#checkout-layout");
    const emptyEl = document.querySelector<HTMLElement>("#checkout-empty");

    if (!layout || !emptyEl) return;

    // This DOM was already set up (init can be triggered twice on a page)
    if (layout.dataset.ready) return;
    layout.dataset.ready = "true";

    const items = getCart();

    if (!items.length) {
      emptyEl.classList.remove("hidden");
      return;
    }

    const form = document.querySelector<HTMLFormElement>("#checkout-form");
    const select = document.querySelector<HTMLSelectElement>("#country");
    const submitBtn = form?.querySelector<HTMLButtonElement>(
      'button[type="submit"]',
    );
    if (!form || !select || !submitBtn) return;

    layout.classList.remove("hidden");

    // ---------- Validation ----------

    const fields = Array.from(
      form.querySelectorAll<Field>("input[name], select[name], textarea[name]"),
    ).filter((el) => el.name in checkoutSchema.shape);
    const touched = new Set<string>();

    // Create an error slot under each field
    for (const el of fields) {
      const errorEl = document.createElement("p");
      errorEl.id = `${el.name}-error`;
      errorEl.className = "mt-1.5 text-sm tracking-wider text-red-600";
      errorEl.setAttribute("aria-live", "polite");
      errorEl.hidden = true;
      // The select sits inside a relative wrapper (for the arrow icon), so go after it
      (el.tagName === "SELECT" ? el.parentElement! : el).after(errorEl);
      el.setAttribute("aria-describedby", errorEl.id);
    }

    function validateField(el: Field): boolean {
      const result = checkoutSchema.shape[el.name as FieldName].safeParse(
        el.value,
      );
      const errorEl = form!.querySelector<HTMLElement>(`#${el.name}-error`)!;

      if (result.success) {
        el.removeAttribute("aria-invalid");
        errorEl.textContent = "";
        errorEl.hidden = true;
      } else {
        el.setAttribute("aria-invalid", "true");
        errorEl.textContent = result.error.issues[0].message;
        errorEl.hidden = false;
      }
      return result.success;
    }

    function updateSubmitState() {
      const data = Object.fromEntries(new FormData(form!));
      submitBtn!.disabled = !checkoutSchema.safeParse(data).success;
    }

    for (const el of fields) {
      el.addEventListener("blur", () => {
        touched.add(el.name);
        validateField(el);
      });
    
      for (const evt of ["input", "change"]) {
        el.addEventListener(evt, () => {
          if (touched.has(el.name)) validateField(el);
          updateSubmitState();
        });
      }
    }

    // ---------- Receipt ----------

    // Use whatever the browser restored/autofilled so the first render is correct
    renderReceipt(items, true, feeFor(select.value));

    // Re-sync the receipt from the select's current value (no animation)
    const sync = () => renderReceipt(items, false, feeFor(select.value));
    select.addEventListener("change", sync);
    select.addEventListener("input", sync);

    // ---------- Submit state ----------

    let submitting = false;
    const submitLabel = submitBtn.textContent;

    function setSubmitting(value: boolean) {
      submitting = value;
      submitBtn!.textContent = value ? "Redirecting to payment…" : submitLabel;
      if (value) submitBtn!.disabled = true;
      else updateSubmitState();
    }

    
    window.addEventListener("pageshow", () => {
      sync();
      if (submitting) setSubmitting(false);
      else updateSubmitState();
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (submitting) return;

      let firstInvalid: Field | null = null;
      for (const el of fields) {
        touched.add(el.name);
        if (!validateField(el) && !firstInvalid) firstInvalid = el;
      }
      if (firstInvalid) return firstInvalid.focus();

      const formData = new FormData(form);
      const text = (key: string) => String(formData.get(key) ?? "").trim();

      const countryCode = text("country"); // select value, e.g. "NG"
      const countryName = findCountry(countryCode)?.name ?? "";

      // The server recalculates prices and shipping, so only ids and quantities go up
      const body: CheckoutRequest = {
        items: items.map((i) => ({ variant_id: i.variantId, quantity: i.qty })),
        customer: {
          name: text("name"),
          email: text("email"),
          phone: toE164(text("phone")),
        },
        shipping_address: {
          line1: text("line1"),
          line2: text("line2") || null,
          city: text("city"),
          state: text("state"),
          postal_code: text("postalCode") || null,
          country: countryName, // "Nigeria"
          country_code: countryCode, // "NG"
        },
        billing_address: null,
        notes: text("notes") || null,
      };

      setSubmitting(true);

      try {
        const res = await fetch("/api/checkout", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(body),
        });
        const data = await res.json().catch(() => ({}));

        if (!res.ok || !data.checkout_url) {
          // Surfaces messages like "Not enough stock for ..."
          toast.error(data.error ?? "Something went wrong. Please try again.");
          return setSubmitting(false);
        }

       
        window.location.assign(data.checkout_url);
      } catch {
        toast.error("Network error. Please try again.");
        setSubmitting(false);
      }
    });

    updateSubmitState();
  }

  init();
  document.addEventListener("astro:page-load", init);
</script>