---
import Layout from "@/layouts/Layout.astro";
import ProductModal from "@/components/ProductModal.astro";
import supabase from "@/lib/supabase";
import { PRODUCT_SELECT, toProduct, cardSummary, catKey } from "@/lib/shop";
import { Image } from "astro:assets";

export const prerender = false;

const [{ data: rows, error }, { data: cats }] = await Promise.all([
  supabase
    .from("artworks")
    .select(PRODUCT_SELECT)
    .eq("is_published", true)
    .order("created_at", { ascending: false })
    .order("sort_order", { referencedTable: "artwork_types" })
    .order("sort_order", { referencedTable: "artwork_types.artwork_variants" }),
  supabase.from("category").select("id, label").order("label"),
]);

if (error) console.error(`Failed to fetch Supabase data: ${error.message}`);

const products = (rows ?? []).map(toProduct);

// Filter tabs come from the category table, so they always match your data
const FILTERS = ["all", ...(cats ?? []).map((c) => c.label.toLowerCase())];

const raw = Astro.url.searchParams.get("filter")?.toLowerCase() ?? "all";
const currentFilter = FILTERS.includes(raw) ? raw : "all";

const inFilter = (p: (typeof products)[number]) =>
  currentFilter === "all" ||
  p.categories.some((c) => catKey(c) === currentFilter);

const activeClasses = "bg-primary text-white font-semibold";
const idleClasses = "hover:bg-primary hover:text-white bg-neutral-200";
const visibleCount = products.filter(inFilter).length;
---

<Layout
  title="Shop"
  description="Collect original paintings, limited edition prints, sculptures, and signed artwork by Edah. Each piece is a portal into worlds of impossibilities and stories to get lost in. Secure checkout, worldwide shipping."
  type="website"
  tags={[
    "art shop",
    "buy art online",
    "original paintings",
    "limited edition prints",
    "sculpture",
    "signed artwork",
  ]}
>
  <section class="content relative w-full px-10 min-h-screen">
    <div class="flex items-start gap-6">
      <aside class="sticky lg:flex hidden w-60 top-40 self-start">
        <div
          class="flex flex-col gap-4 h-fit w-full bg-neutral-100 rounded-xl p-6"
        >
          <h3 class="font-architects-daughter text-xl tracking-wider mb-4">
            Categories
          </h3>
          {
            FILTERS.map((filter) => (
              <a
                href={`${
                  filter === "all"
                    ? "/shop"
                    : `/shop?filter=${encodeURIComponent(filter)}`
                }`}
                data-filter={filter}
                class:list={[
                  "w-full text-left px-4 py-2 rounded-lg transition-colors capitalize",
                  filter === currentFilter ? activeClasses : idleClasses,
                ]}
              >
                {filter}
              </a>
            ))
          }
        </div>
      </aside>

      <section class="flex w-full flex-col items-center gap-6 flex-1">
        <h2
          class="text-3xl sm:text-6xl font-bold mb-5 tracking-wider text-center w-full"
        >
          Shop the collection
        </h2>
        <p class="max-w-3xl tracking-widest font-light text-center">
          Thank you for visiting my art shop. Each piece serves as a portal into
          worlds of impossibilities and stories to get lost in. I invite you to
          wander through these creations, hoping you find a piece that connects
          with you.
        </p>

        <div
          id="mobile-filter"
          class="flex w-full items-center gap-2 overflow-x-auto my-5 pr-10 lg:hidden scrollbar-none [&::-webkit-scrollbar]:hidden mask-[linear-gradient(to_right,black_88%,transparent)]"
        >
          {
            FILTERS.map((filter) => (
              <a
                href={`/shop?filter=${encodeURIComponent(filter)}`}
                data-filter={filter}
                class:list={[
                  "shrink-0 whitespace-nowrap text-sm px-4 py-2 rounded-lg transition-colors capitalize",
                  filter === currentFilter ? activeClasses : idleClasses,
                ]}
              >
                {filter}
              </a>
            ))
          }
        </div>

        <div
          id="shop-grid"
          class="w-full mt-8 grid gap-6 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3"
        >
          {
            products.map((product, i) => {
              const summary = cardSummary(product, currentFilter);

              return (
                <article
                  data-product
                  data-product-id={product.id}
                  data-category={product.categories.map(catKey).join(" ")}
                  class:list={[
                    "group flex flex-col gap-4",
                    { hidden: !inFilter(product) },
                  ]}
                >
                  <div class="relative aspect-4/5 overflow-hidden rounded-xl bg-neutral-100">
                    <button
                      type="button"
                      data-open
                      data-product-id={product.id}
                      aria-label={`View ${product.title}`}
                      class="block h-full w-full cursor-pointer"
                    >
                      <Image
                        src={product.images[0] ?? "/placeholder.svg"}
                        alt={product.title}
                        width={600}
                        height={750}
                        widths={[400, 600, 900]}
                        sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
                        quality={75}
                        loading={i < 2 ? "eager" : "lazy"}
                        fetchpriority={i === 0 ? "high" : "auto"}
                        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                      />
                    </button>
                    <span
                      data-badge
                      class="pointer-events-none absolute left-3 top-3 rounded-full bg-white/90 px-3 py-1 text-xs capitalize backdrop-blur"
                    >
                      {summary.badge}
                    </span>
                  </div>

                  <div class="flex flex-1 flex-col gap-3">
                    <div class="flex items-start justify-between gap-4">
                      <h3 class="font-architects-daughter max-w-[80%] truncate text-lg leading-tight tracking-wider">
                        {product.title}
                      </h3>
                     {summary.price.toLowerCase() === "enquire"
                ? (
                  <a
                  data-price-display
                    href="/contact"
                    class="font-biryani shrink-0 text-sm font-medium text-primary hover:underline underline-offset-4"
                  >
                    {summary.price}
                  </a>
                )
                : (
                  <span 
                  data-price-display
                  
                  class="font-biryani shrink-0 font-medium">
                    {summary.price}
                  </span>
                )}
                    </div>

                    <button
                      type="button"
                      data-open
                      data-product-id={product.id}
                      class="mt-auto w-full cursor-pointer rounded-lg border border-primary px-4 py-3 text-sm font-medium tracking-wider text-primary transition-colors hover:bg-primary hover:text-white active:scale-[0.98]"
                    >
                      Collect this artwork
                    </button>
                  </div>
                </article>
              );
            })
          }
        </div>

        <div
          id="empty"
          class:list={[
            "text-center flex flex-col items-center gap-8 w-full py-12 text-neutral-500",
            { hidden: visibleCount > 0 },
          ]}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="20 -20 500 680"
            class="mx-auto h-36 w-auto overflow-visible"
            fill="none"
            stroke="#222222"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <g transform="translate(10, 0)">
              <path
                stroke-width="20"
                d="M 172 360 L 52 575 C 42 592 50 618 72 626 L 102 636 C 122 642 144 630 152 612 L 232 390"
              ></path>

              <!-- Handle grip lines -->
              <path stroke-width="12" d="M 52 588 C 72 600 102 612 122 618"
              ></path>
              <path stroke-width="12" d="M 64 566 C 82 578 112 590 130 596"
              ></path>
              <path stroke-width="12" d="M 76 544 C 94 554 122 566 138 572"
              ></path>

              <!-- Outer ring -->
              <ellipse
                cx="282"
                cy="192"
                rx="206"
                ry="186"
                stroke-width="22"
                transform="rotate(-22 282 192)"></ellipse>
              <ellipse
                cx="282"
                cy="192"
                rx="166"
                ry="148"
                stroke-width="16"
                transform="rotate(-22 282 192)"></ellipse>

              <!-- Glare marks -->
              <path stroke-width="16" d="M 180 185 C 160 110 205 60 255 48"
              ></path>
              <path stroke-width="14" d="M 162 226 C 158 212 160 200 166 195"
              ></path>
            </g>
          </svg>

          <p>This category looks empty...</p>
        </div>
      </section>
    </div>
  </section>

  <ProductModal products={products} />
</Layout>
