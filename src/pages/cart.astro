---
// src/pages/cart.astro
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Cart">
  <section class="content mt-20 px-6 pb-20 md:px-10 min-h-[calc(100vh-20rem)]">
    <header class="mb-10 flex flex-col gap-2">
      <h1 class="text-5xl tracking-widest text-[#6b5252] md:text-6xl">
        your cart
      </h1>
      <p id="cart-count" class="tracking-wide my-6 text-neutral-500"></p>
    </header>

    <!-- Cart with items -->
    <div
      id="cart-layout"
      class="hidden items-start gap-10 lg:grid lg:grid-cols-[minmax(0,1fr)_24rem] min-h-[calc(100vh-32rem)]"
    >
      <div class="flex-1 min-w-0">
        <ul id="cart-items" class="flex flex-col gap-4"></ul>
      </div>

      <aside
        class="mx-auto mt-10 w-full max-w-md sticky top-40 lg:mx-0 lg:mt-0 lg:max-w-none lg:self-start"
      >
        <div class="">
          <div class="receipt-wrap ">
            <div
              id="receipt"
              class="receipt bg-white px-6 pb-12 pt-8 font-mono text-sm tabular-nums text-neutral-800"
            >
              <header class="text-center">
                <p class="font-bold uppercase tracking-[0.3em]">Edah.Artist</p>
                <p id="receipt-date" class="mt-3 text-xs text-neutral-500"></p>
              </header>

              <hr class="my-5 border-dashed border-neutral-400" />

              <p
                class="mb-3 text-xs uppercase tracking-widest text-neutral-500"
              >
                Order summary
              </p>
              <ul id="receipt-lines" class="flex flex-col gap-2"></ul>

              <hr class="my-5 border-dashed border-neutral-400" />

              <dl class="flex flex-col gap-2">
                <div class="flex justify-between">
                  <dt>Items</dt>
                  <dd id="summary-count"></dd>
                </div>
                <div class="flex justify-between">
                  <dt>Subtotal</dt>
                  <dd id="subtotal"></dd>
                </div>
                <div class="flex justify-between">
                  <dt>Shipping</dt>
                  <dd class="text-neutral-500">at checkout</dd>
                </div>
              </dl>

              <div
                class="mt-5 flex items-baseline justify-between border-t-4 border-double border-neutral-800 pt-4"
              >
                <span class="text-base font-bold uppercase tracking-widest">
                  Total
                </span>
                <span id="total" class="text-2xl font-bold"></span>
              </div>

              <div
                class="mt-8 flex flex-col items-center gap-2"
                aria-hidden="true"
              >
                <div class="barcode h-12 w-full"></div>
                <p class="text-xs tracking-[0.3em] text-neutral-500">
                  THANK YOU
                </p>
              </div>
            </div>
          </div>

          <a
            href="/checkout"
            class="mt-8 block w-full rounded-full bg-primary px-6 py-3 text-center font-semibold text-white transition-opacity hover:opacity-90"
          >
            Proceed to checkout
          </a>
          <a
            href="/shop"
            class="mt-3 block w-full rounded-full px-6 py-3 text-center text-sm transition-colors hover:bg-neutral-200"
          >
            Continue shopping
          </a>
        </div>
      </aside>
    </div>

    <!-- Empty state -->
    <div
      id="cart-empty"
      class="hidden flex-col items-center gap-6 rounded-xl bg-neutral-100 px-6 py-20 text-center"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="48"
        height="48"
        viewBox="0 0 24 24"
        fill="none"
        stroke="#6b5252"
        stroke-width="1.25"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="9" cy="20" r="1.5"></circle>
        <circle cx="18" cy="20" r="1.5"></circle>
        <path d="M2 3h3l2.4 11.2a2 2 0 0 0 2 1.6h8.2a2 2 0 0 0 2-1.5L21 7H6"
        ></path>
      </svg>
      <h2 class="text-3xl tracking-widest text-[#6b5252]">nothing here yet</h2>
      <p class="max-w-md tracking-wide text-neutral-600">
        Your cart is empty. The collection is waiting whenever you're ready to
        wander through it.
      </p>
      <a
        href="/shop"
        class="rounded-full bg-primary px-8 py-3 font-semibold text-white transition-opacity hover:opacity-90"
      >
        Browse the shop
      </a>
    </div>
  </section>

  <!-- One cart row; cloned by the script -->
  <template id="cart-item-template">
    <li class="flex gap-4 rounded-xl bg-neutral-100 p-4 sm:gap-6">
      <img
        data-image
        alt=""
        class="h-28 w-28 shrink-0 rounded-lg bg-neutral-200 object-cover sm:h-36 sm:w-36"
      />

      <div class="flex min-w-0 flex-1 flex-col justify-between gap-4">
        <div class="flex items-start justify-between gap-4">
          <div class="min-w-0">
            <h3
              data-title
              class="font-architects-daughter text-lg tracking-wider sm:text-xl"
            >
            </h3>
            <p data-category class="text-xs capitalize text-neutral-500"></p>
            <p data-unit class="mt-1 text-sm text-neutral-600"></p>
          </div>

          <button
            type="button"
            data-action="remove"
            aria-label="Remove item"
            class="-mr-1 -mt-1 rounded-full p-2 text-neutral-500 transition-colors hover:bg-neutral-200 hover:text-neutral-900"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M18 6 6 18M6 6l12 12"></path>
            </svg>
          </button>
        </div>

        <div class="flex items-center justify-between gap-4">
          <div
            class="inline-flex items-center rounded-full border border-neutral-300 bg-white"
          >
            <button
              type="button"
              data-action="dec"
              aria-label="Decrease quantity"
              class="h-9 w-9 rounded-full text-lg transition-colors hover:bg-neutral-100 disabled:opacity-30 disabled:hover:bg-transparent"
            >
              −
            </button>
            <span
              data-qty
              aria-live="polite"
              class="w-8 text-center text-sm font-medium"></span>
            <button
              type="button"
              data-action="inc"
              aria-label="Increase quantity"
              class="h-9 w-9 rounded-full text-lg transition-colors hover:bg-neutral-100 disabled:opacity-30 disabled:hover:bg-transparent"
            >
              +
            </button>
          </div>

          <span data-line-total class="font-biryani text-lg font-medium"></span>
        </div>
      </div>
    </li>
  </template>
</Layout>

<style>
  /* Soft shadow lives on the wrapper because mask would clip it on the paper */
  .receipt-wrap {
    filter: drop-shadow(0 6px 12px rgb(0 0 0 / 0.12));
  }

  /* Sawtooth torn edge along the bottom (teeth are 10px tall) */
  .receipt {
    -webkit-mask: conic-gradient(
        from -45deg at bottom,
        #0000,
        #000 1deg 89deg,
        #0000 90deg
      )
      50% / 20px 100%;
    mask: conic-gradient(
        from -45deg at bottom,
        #0000,
        #000 1deg 89deg,
        #0000 90deg
      )
      50% / 20px 100%;
  }

  /* Decorative barcode */
  .barcode {
    background: repeating-linear-gradient(
      90deg,
      #1f1f1f 0 2px,
      transparent 2px 4px,
      #1f1f1f 4px 5px,
      transparent 5px 8px,
      #1f1f1f 8px 11px,
      transparent 11px 13px,
      #1f1f1f 13px 14px,
      transparent 14px 18px
    );
  }
</style>

<script>
  import { animate, stagger } from "motion";
  import {
    getCart,
    saveCart,
    cartCount,
    cartSubtotal,
    formatPrice,
    syncCartBadges,
    MAX_QTY,
    type CartItem,
  } from "@/lib/cart";

  function init() {
    const list = document.querySelector<HTMLUListElement>("#cart-items");
    const tpl = document.querySelector<HTMLTemplateElement>(
      "#cart-item-template",
    );
    const layout = document.querySelector<HTMLElement>("#cart-layout");
    const emptyEl = document.querySelector<HTMLElement>("#cart-empty");
    const countEl = document.querySelector<HTMLElement>("#cart-count");
    const summaryCount = document.querySelector<HTMLElement>("#summary-count");
    const subtotalEl = document.querySelector<HTMLElement>("#subtotal");
    const totalEl = document.querySelector<HTMLElement>("#total");
    const receipt = document.querySelector<HTMLElement>("#receipt");
    const receiptWrap = document.querySelector<HTMLElement>(".receipt-wrap");
    const receiptLines =
      document.querySelector<HTMLUListElement>("#receipt-lines");
    const receiptDate = document.querySelector<HTMLElement>("#receipt-date");

    if (
      !list ||
      !tpl ||
      !layout ||
      !emptyEl ||
      !countEl ||
      !summaryCount ||
      !subtotalEl ||
      !totalEl ||
      !receipt ||
      !receiptWrap ||
      !receiptLines ||
      !receiptDate
    )
      return;

    const plural = (n: number) => `${n} ${n === 1 ? "item" : "items"}`;

    function buildRow(item: CartItem) {
      const row = tpl!.content.firstElementChild!.cloneNode(
        true,
      ) as HTMLElement;
      row.dataset.id = String(item.id);

      const img = row.querySelector<HTMLImageElement>("[data-image]")!;
      img.src = item.image;
      img.alt = item.title;

      row.querySelector("[data-title]")!.textContent = item.title;
      row.querySelector("[data-category]")!.textContent = item.category;
      row.querySelector("[data-unit]")!.textContent = `${formatPrice(
        item.price,
      )} each`;
      row.querySelector("[data-qty]")!.textContent = String(item.qty);
      row.querySelector("[data-line-total]")!.textContent = formatPrice(
        item.price * item.qty,
      );

      row.querySelector<HTMLButtonElement>('[data-action="dec"]')!.disabled =
        item.qty <= 1;
      row.querySelector<HTMLButtonElement>('[data-action="inc"]')!.disabled =
        item.qty >= MAX_QTY;

      return row;
    }

    // One receipt line: "2 x Title ........ $300"
    function buildReceiptLine(item: CartItem) {
      const li = document.createElement("li");
      li.className = "flex items-baseline gap-2";

      const name = document.createElement("span");
      name.className = "min-w-0 truncate";
      name.textContent = `${item.qty} x ${item.title}`;
      name.title = item.title;

      const leader = document.createElement("span");
      leader.className = "flex-1 border-b border-dotted border-neutral-400";

      const price = document.createElement("span");
      price.textContent = formatPrice(item.price * item.qty);

      li.append(name, leader, price);
      return li;
    }

    receiptDate!.textContent = new Date().toLocaleString("en-GB", {
      day: "2-digit",
      month: "short",
      year: "numeric",
      hour: "2-digit",
      minute: "2-digit",
    });

    function render(animateIn = false) {
      const items = getCart();
      const isEmpty = items.length === 0;

      layout!.classList.toggle("hidden", isEmpty);
      emptyEl!.classList.toggle("hidden", !isEmpty);
      emptyEl!.classList.toggle("flex", isEmpty);
      receiptWrap!.classList.toggle("hidden", isEmpty);

      list!.replaceChildren(...items.map(buildRow));
      receiptLines!.replaceChildren(...items.map(buildReceiptLine));

      const count = cartCount(items);
      const subtotal = formatPrice(cartSubtotal(items));
      countEl!.textContent = isEmpty ? "" : plural(count);
      summaryCount!.textContent = String(count);
      subtotalEl!.textContent = subtotal;
      totalEl!.textContent = subtotal;

      syncCartBadges();

      if (animateIn) {
        const targets = isEmpty
          ? [emptyEl!]
          : Array.from(list!.children as HTMLCollectionOf<HTMLElement>);
        animate(
          targets,
          { opacity: [0, 1], y: [16, 0] },
          { duration: 0.35, delay: stagger(0.06), ease: "easeOut" },
        );

        // The receipt "prints" downward
        if (!isEmpty) {
          animate(
            receipt!,
            { clipPath: ["inset(0 0 100% 0)", "inset(0 0 0% 0)"] },
            { duration: 0.9, ease: "easeOut" },
          );
        }
      }
    }

    list.addEventListener("click", async (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(
        "[data-action]",
      );
      if (!btn || btn.disabled) return;

      const row = btn.closest<HTMLElement>("[data-id]")!;
      const id = Number(row.dataset.id);
      const items = getCart();
      const item = items.find((i) => i.id === id);
      if (!item) return;

      if (btn.dataset.action === "remove") {
        await animate(row, { opacity: 0, x: -24 }, { duration: 0.2 });
        saveCart(items.filter((i) => i.id !== id));
      } else {
        const next = item.qty + (btn.dataset.action === "inc" ? 1 : -1);
        item.qty = Math.min(MAX_QTY, Math.max(1, next));
        saveCart(items);
      }

      render();
    });

    window.addEventListener("storage", () => render());

    render(true);
  }

  init();
</script>

