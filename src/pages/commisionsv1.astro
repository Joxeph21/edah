---
import Layout from "@/layouts/Layout.astro";
import { Image } from "astro:assets";
import drummer from "@/assets/images/drummer.webp";

// Swap these for real artwork (polaroid head, fire hose pair, etc).
const heroImage = drummer;
const waitlistImage = drummer;

const objects = ["a camera", "a fire hose", "a teapot", "a lantern", "a typewriter"];

const steps = [
  {
    title: "we talk",
    text: "A relaxed 'get to know you' conversation. Stories, symbols, the things you keep coming back to.",
  },
  {
    title: "we find your object",
    text: "I pull fragments from your inner world and settle on the object that best represents you.",
  },
  {
    title: "you see sketches",
    text: "Early sketches come to you before any paint. You give feedback until it feels right.",
  },
  {
    title: "I paint, then ship",
    text: "Made slowly and intentionally, then packaged with care and sent to you.",
  },
];

const faqs = [
  {
    q: "who are these commissions for?",
    a: "Anyone who wants to be seen as who they are, not just how they look. They make meaningful gifts, too.",
  },
  {
    q: "how does it work?",
    a: "You join the waitlist, and when you're next in line I reach out to start our conversation. Once we agree on the direction, I begin the piece and share progress along the way.",
  },
  {
    q: "what size/s do you offer?",
    a: "Sizes vary. We'll choose what suits your space and budget during our first conversation.",
  },
  {
    q: "how much does it cost?",
    a: "Pricing depends on size and complexity. You'll get a clear quote before any work begins.",
  },
  {
    q: "is it world-wide?",
    a: "Yes. Every piece is carefully packaged and insured.",
  },
  {
    q: "do I pay shipping?",
    a: "Yes, shipping is quoted separately based on your location and the size of the piece.",
  },
  {
    q: "can you paint me into a scene?",
    a: "Yes. We can talk through a setting that carries meaning for you, and I'll let you know what's possible.",
  },
  {
    q: "how long does it take?",
    a: "Most commissions take several weeks once started. I'll give you a realistic timeline when we begin.",
  },
  {
    q: "can you do couples?",
    a: "Yes. Two heads, two objects, one painting. Mention it when we first talk.",
  },
  {
    q: "what if I'm not happy with it?",
    a: "I'll work with you to make it right. Your approval at each stage is how we avoid surprises at the end.",
  },
];

const half = Math.ceil(faqs.length / 2);
const columns = [faqs.slice(0, half), faqs.slice(half)];

const inputClass =
  "w-full rounded-lg border border-white/20 bg-white/5 px-4 py-3 text-sm tracking-wider text-white outline-none transition placeholder:text-white/50 focus:border-white/70 focus:bg-white/10";
---

<Layout
  title="Commissions"
  description="Object-head portrait commissions by Edah. Join the waitlist for a one-of-a-kind artwork reimagining you as a symbolic character. Hand-painted slowly and intentionally, shipped worldwide."
  type="website"
  tags={["portrait commissions", "object-head portraits", "custom artwork", "art waitlist", "edah"]}
  noIndex={true}
  noFollow={true}
>
  <!-- Hero -->
  <section
    class="content grid w-full items-center gap-12 px-10 pt-16 pb-14 lg:grid-cols-[1.25fr_1fr] lg:gap-20"
  >
    <div class="text-center lg:text-left">
      <p class="font-architects-daughter text-lg tracking-widest text-neutral-500">
        object-head portrait commissions
      </p>

      <h1
        class="font-architects-daughter mt-4 text-5xl font-bold leading-tight tracking-wider sm:text-6xl xl:text-7xl"
      >
        what would your head be?
      </h1>

      <div
        class="font-architects-daughter mt-3 text-4xl font-bold tracking-wider text-primary sm:text-5xl xl:text-6xl"
      >
        <span class="sr-only">Something that is uniquely you.</span>
        <div class="cycle mx-auto lg:mx-0" aria-hidden="true">
          <ul>
            {objects.map((o) => <li>{o}</li>)}
            <li>{objects[0]}</li>
          </ul>
        </div>
      </div>

      <p
        class="mt-8 max-w-xl font-light leading-relaxed tracking-widest text-neutral-600 lg:max-w-lg"
      >
        "I am not chained to this reality, and neither, dear dreamer, are you."
      </p>

      <a
        href="#waitlist"
        class="mt-8 inline-block rounded-lg bg-primary px-10 py-3 text-sm font-medium tracking-wider text-white transition hover:opacity-90 active:scale-[0.98]"
      >
        join the waitlist
      </a>
    </div>

    <figure class="polaroid mx-auto w-full max-w-sm lg:mt-20 lg:max-w-none">
      <div class="aspect-4/5 overflow-hidden rounded-lg bg-neutral-100">
        <Image
          src={heroImage}
          alt="Object-head portrait of a person with a vintage camera for a head"
          class="pointer-events-none h-full w-full select-none object-cover"
        />
      </div>
      <figcaption
        class="font-architects-daughter pt-5 pb-2 text-center text-lg tracking-widest text-white/80"
      >
        a camera head, for someone who sees everything
      </figcaption>
    </figure>
  </section>

  <!-- Intro -->
  <section class="content w-full px-10 py-14">
    <div
      class="mx-auto grid max-w-5xl gap-10 text-center font-light leading-relaxed tracking-widest md:grid-cols-2 md:gap-16 md:text-left"
    >
      <p class="text-lg md:text-xl">
        An object-head portrait is your invitation to be reimagined: not as how
        you are seen, but as who you are.
      </p>
      <div class="flex flex-col gap-5 text-neutral-700">
        <p>
          We'll transform you into your very own object-head character, guided
          by personal stories, symbolism and the details that make you,
          <em>you</em>. The result is a one-of-a-kind artwork that exists nowhere
          else, created as part of my ongoing object-head universe.
        </p>
      </div>
    </div>
  </section>

  <!-- Process (a real sequence, so it is numbered) -->
  <section class="content w-full px-10 py-14">
    <h2
      class="font-architects-daughter mb-12 text-center text-4xl font-bold tracking-wider sm:text-5xl"
    >
      how a portrait gets made
    </h2>

    <ol class="grid gap-10 md:grid-cols-4 md:gap-6">
      {
        steps.map((s, i) => (
          <li class="relative md:pt-8">
            <span class="absolute top-0 left-0 hidden h-px w-full bg-neutral-300 md:block" />
            <span class="absolute top-0 left-0 hidden size-3 -translate-y-1/2 rounded-full bg-primary md:block" />
            <span class="font-architects-daughter text-3xl text-primary">
              {i + 1}
            </span>
            <h3 class="font-architects-daughter mt-1 text-xl font-bold tracking-wider">
              {s.title}
            </h3>
            <p class="mt-2 font-light leading-relaxed tracking-wider text-neutral-600">
              {s.text}
            </p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Waitlist -->
  <section id="waitlist" class="content w-full scroll-mt-8 px-5 lg:px-10 py-14">
    <div
      class="grid overflow-hidden rounded-3xl bg-[#2a2630] text-white lg:grid-cols-[2fr_3fr]"
    >
      <figure class="relative min-h-80 lg:min-h-full">
        <Image
          src={waitlistImage}
          alt="Two object-head characters standing side by side"
          class="pointer-events-none absolute inset-0 h-full w-full select-none object-cover"
        />
      </figure>

      <div class="flex flex-col items-center gap-6 px-8 py-14 sm:px-14">
        <h2
          class="font-architects-daughter text-center text-4xl font-bold tracking-wider sm:text-5xl"
        >
          join the waitlist
        </h2>

        <p class="max-w-md text-center font-light leading-relaxed tracking-widest text-white/75">
          Commissions are currently open and availability is
          limited. It's first in, first served. Joining just means you're on the
          list, and I'll reach out when you're next in line.
        </p>

        <form
          action="#"
          method="POST"
          class="mt-2 flex w-full max-w-lg flex-col gap-4"
        >
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <input
              name="firstName"
              type="text"
              autocomplete="given-name"
              placeholder="First name"
              aria-label="First name"
              required
              class={inputClass}
            />
            <input
              name="lastName"
              type="text"
              autocomplete="family-name"
              placeholder="Last name"
              aria-label="Last name"
              required
              class={inputClass}
            />
          </div>

          <input
            name="email"
            type="email"
            autocomplete="email"
            placeholder="Email address"
            aria-label="Email address"
            required
            class={inputClass}
          />

          <textarea
            name="idea"
            rows="3"
            placeholder="Any object already in mind? (optional)"
            aria-label="Object ideas"
            class={`${inputClass} resize-none`}></textarea>

          <button
            type="submit"
            class="mx-auto mt-2 w-fit cursor-pointer rounded-lg bg-white px-10 py-3 text-sm font-medium tracking-wider text-[#2a2630] transition hover:bg-white/90 active:scale-[0.98]"
          >
            join
          </button>
        </form>

        <p class="max-w-md text-center text-xs font-light leading-relaxed tracking-widest text-white/60">
          By joining the waitlist, you agree to be part of my newsletter
          community :)
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="content w-full px-10 py-16">
    <h2
      class="font-architects-daughter mb-12 text-center text-4xl font-bold tracking-wider sm:text-5xl"
    >
      common questions &amp; answers
    </h2>

    <div class="grid grid-cols-1 gap-x-16 md:grid-cols-2 md:items-start">
      {
        columns.map((column) => (
          <div class="border-b border-neutral-300">
            {column.map((item) => (
              <details class="group border-t border-neutral-300">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-6 tracking-widest focus-visible:outline-2 focus-visible:outline-primary [&::-webkit-details-marker]:hidden">
                  <span>{item.q}</span>
                  <span
                    class="text-2xl font-light leading-none transition-transform duration-300 group-open:rotate-45"
                    aria-hidden="true"
                  >
                    +
                  </span>
                </summary>
                <p class="pb-6 pr-10 font-light leading-relaxed tracking-wider text-neutral-600">
                  {item.a}
                </p>
              </details>
            ))}
          </div>
        ))
      }
    </div>
  </section>
</Layout>

<style>
  /* Cycling object words */
  .cycle {
    --lh: 1.3em;
    height: var(--lh);
    line-height: var(--lh);
    overflow: hidden;
  }
  .cycle ul {
    animation: cycle 12s ease-in-out infinite;
  }
  .cycle li {
    height: var(--lh);
    white-space: nowrap;
  }
  @keyframes cycle {
    0%,
    16% {
      transform: translateY(0);
    }
    20%,
    36% {
      transform: translateY(calc(var(--lh) * -1));
    }
    40%,
    56% {
      transform: translateY(calc(var(--lh) * -2));
    }
    60%,
    76% {
      transform: translateY(calc(var(--lh) * -3));
    }
    80%,
    96% {
      transform: translateY(calc(var(--lh) * -4));
    }
    100% {
      transform: translateY(calc(var(--lh) * -5));
    }
  }

  /* Polaroid-style frame, echoing the black-framed art */
  .polaroid {
    background: #1c1a1f;
    border-radius: 1.25rem;
    padding: 0.9rem 0.9rem 1.1rem;
    transform: rotate(2deg);
    box-shadow: 0 18px 40px -18px rgba(28, 26, 31, 0.55);
  }

  @media (prefers-reduced-motion: reduce) {
    .cycle ul {
      animation: none;
    }
  }
</style>