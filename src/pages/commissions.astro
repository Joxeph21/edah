---
import Layout from "@/layouts/Layout.astro";
import { Image } from "astro:assets";
import {
  FILE_ACCEPT,
  MAX_FILES,
  MAX_FILE_SIZE,
} from "schemas/commissionSchema";

import maskImg from "@/assets/images/mask.webp";
import muralImg from "@/assets/images/mural.webp";
import sculptureImg from "@/assets/images/sanctuary.webp";
import coverImg from "@/assets/images/cover-art.webp";

const types = [
  {
    id: "mask",
    title: "custom masks",
    blurb: "Wearable pieces made around a character, story or theme.",
    image: maskImg,
  },
  {
    id: "mural",
    title: "murals",
    blurb: "Large-scale work painted directly onto your wall or space.",
    image: muralImg,
  },
  {
    id: "sculpture",
    title: "sculptures",
    blurb: "One-of-a-kind three-dimensional pieces made to your brief.",
    image: sculptureImg,
  },
  {
    id: "cover-art",
    title: "cover art",
    blurb: "Original artwork for albums, books, EPs and singles.",
    image: coverImg,
  },
];

const steps = [
  {
    title: "you tell me",
    text: "Choose the type of piece, describe what it's about and share anything that inspires you.",
  },
  {
    title: "we talk it through",
    text: "I reply with questions, ideas and a clear quote and timeline before anything starts.",
  },
  {
    title: "I make it",
    text: "I work on your piece and share progress so you can give feedback along the way.",
  },
  {
    title: "it's yours",
    text: "Your finished piece is delivered, shipped or installed, depending on what it is.",
  },
];

const faqs = [
  {
    q: "what can I commission?",
    a: "Custom masks, murals, sculptures and cover art. If your idea sits somewhere in between, tell me and we'll see if it's a fit.",
  },
  {
    q: "do I need a finished idea?",
    a: "No. A rough description, a mood or a few photos is enough to start. I'll help shape it from there.",
  },
  {
    q: "how do I share inspiration?",
    a: "Upload photos in the form, or just describe what you have in mind. You can send more images later by email.",
  },
  {
    q: "how much does it cost?",
    a: "It depends on the type, size, materials and how detailed the piece is. You'll get a clear quote before I begin.",
  },
  {
    q: "how long does it take?",
    a: "A mask or cover art usually takes a few weeks. Sculptures and murals take longer. I'll give you a realistic schedule up front.",
  },
  {
    q: "can you paint a mural in my city?",
    a: "Murals can be done on location depending on travel and scheduling. Tell me where the wall is and I'll confirm what's possible.",
  },
  {
    q: "do you ship worldwide?",
    a: "Yes. Masks and sculptures are carefully packed and shipped, with shipping quoted separately.",
  },
  {
    q: "can I ask for changes?",
    a: "Yes. You'll see progress along the way and can give feedback before the piece is finished.",
  },
];

const half = Math.ceil(faqs.length / 2);
const columns = [faqs.slice(0, half), faqs.slice(half)];

const inputClass =
  "w-full rounded-lg border border-neutral-300 bg-white px-4 py-3 text-sm tracking-wider outline-none transition placeholder:text-neutral-400 focus:border-primary focus:ring-2 focus:ring-primary/10 aria-invalid:border-red-500 aria-invalid:focus:border-red-500 aria-invalid:focus:ring-red-500/20";
const labelClass = "mb-2 block text-sm font-medium tracking-wider";
const errorClass = "mt-1.5 text-sm tracking-wider text-red-600";
---

<Layout
  title="Commissions"
  description="Commission custom artwork from Edah — masks, murals, sculptures, and cover art. Share your idea and receive a unique piece made through collaborative process. Worldwide shipping available."
  type="website"
  tags={[
    "custom art commissions",
    "custom masks",
    "murals",
    "sculptures",
    "cover art",
    "commission artwork",
  ]}
>
  <!-- Hero + commission types -->
  <section class="content w-full px-10 pt-16 pb-10">
    <div class="mx-auto flex max-w-3xl flex-col items-center gap-5 text-center">
      <p
        class="font-architects-daughter text-lg tracking-widest text-neutral-500"
      >
        commissions
      </p>
      <h1
        class="font-architects-daughter text-3xl font-bold leading-tight tracking-wider sm:text-6xl"
      >
        made for you, from your idea
      </h1>
      <p class="font-light leading-relaxed tracking-widest text-neutral-600">
        Tell me what you'd like to make, what it's about and what inspires you.
        I'll turn it into a piece that exists nowhere else.
      </p>
    </div>

    <ul class="mt-14 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        types.map((t) => (
          <li>
            <a
              href="#request"
              data-pick={t.id}
              class="group flex flex-col gap-4"
            >
              <div class="aspect-4/5 overflow-hidden rounded-xl bg-neutral-100">
                <Image
                  src={t.image}
                  alt={t.title}
                  class="pointer-events-none h-full w-full select-none object-cover transition-transform duration-500 group-hover:scale-105"
                />
              </div>
              <div>
                <h2 class="font-architects-daughter text-xl font-bold tracking-wider">
                  {t.title}
                </h2>
                <p class="mt-1 text-sm font-light leading-relaxed tracking-wider text-neutral-600">
                  {t.blurb}
                </p>
                <span class="mt-3 inline-block text-sm tracking-wider text-primary underline-offset-4 group-hover:underline">
                  start a request →
                </span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Process -->
  <section class="content w-full px-10 py-16">
    <h2
      class="font-architects-daughter mb-12 text-center text-4xl font-bold tracking-wider sm:text-5xl"
    >
      how it works
    </h2>

    <ol class="grid gap-10 md:grid-cols-4 md:gap-6">
      {
        steps.map((s, i) => (
          <li class="border-t border-neutral-300 pt-6">
            <span class="font-architects-daughter text-3xl text-primary">
              {String(i + 1).padStart(2, "0")}
            </span>
            <h3 class="font-architects-daughter mt-2 text-xl font-bold tracking-wider">
              {s.title}
            </h3>
            <p class="mt-2 font-light leading-relaxed tracking-wider text-neutral-600">
              {s.text}
            </p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Request form -->
  <section id="request" class="content w-full scroll-mt-8 px-10 py-16">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.4fr] lg:gap-20">
      <div class="lg:sticky lg:top-32 lg:self-start">
        <h2
          class="font-architects-daughter text-4xl font-bold tracking-wider sm:text-5xl"
        >
          start a commission
        </h2>
        <p
          class="mt-5 font-light leading-relaxed tracking-widest text-neutral-600"
        >
          Share as much or as little as you like. A few lines about the idea and
          some inspiration photos are plenty to get started.
        </p>
        <p
          class="mt-4 font-light leading-relaxed tracking-widest text-neutral-600"
        >
          I'll reply by email with questions and a quote. Nothing is booked
          until you say yes.
        </p>
      </div>

      <form
        action="#"
        method="POST"
        enctype="multipart/form-data"
        novalidate
        data-commission-form
        class="flex flex-col gap-8 rounded-2xl bg-neutral-100 p-6 sm:p-10"
      >
        <fieldset id="type" aria-describedby="type-error">
          <legend class={labelClass}>What would you like made?</legend>
          <div class="flex flex-wrap gap-2">
            {
              types.map((t, i) => (
                <label class="cursor-pointer">
                  <input
                    type="radio"
                    name="type"
                    value={t.id}
                    required={i === 0}
                    class="peer sr-only"
                  />
                  <span class="block rounded-lg border border-neutral-300 bg-white px-4 py-2 text-sm capitalize tracking-wider transition-colors hover:border-primary peer-checked:border-primary peer-checked:bg-primary peer-checked:text-white peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-primary">
                    {t.title}
                  </span>
                </label>
              ))
            }
            <label class="cursor-pointer">
              <input
                type="radio"
                name="type"
                value={"other"}
                class="peer sr-only"
              />
              <span
                class="block rounded-lg border border-neutral-300 bg-white px-4 py-2 text-sm capitalize tracking-wider transition-colors hover:border-primary peer-checked:border-primary peer-checked:bg-primary peer-checked:text-white peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-primary"
              >
                Other
              </span>
            </label>
          </div>
          <p id="type-error" class={errorClass} aria-live="polite" hidden></p>
        </fieldset>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
          <div>
            <label for="name" class={labelClass}>Name</label>
            <input
              id="name"
              name="name"
              type="text"
              autocomplete="name"
              required
              aria-describedby="name-error"
              class={inputClass}
            />
            <p id="name-error" class={errorClass} aria-live="polite" hidden></p>
          </div>
          <div>
            <label for="email" class={labelClass}>Email</label>
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              required
              aria-describedby="email-error"
              class={inputClass}
            />
            <p id="email-error" class={errorClass} aria-live="polite" hidden>
            </p>
          </div>
        </div>

        <div>
          <label for="about" class={labelClass}>What is it about?</label>
          <textarea
            id="about"
            name="about"
            rows="6"
            required
            aria-describedby="about-error"
            placeholder="Describe the idea, the story or feeling behind it, colours, materials, anything that matters to you."
            class={`${inputClass} resize-none`}></textarea>
          <p id="about-error" class={errorClass} aria-live="polite" hidden></p>
        </div>

        <div>
          <span class={labelClass}>Inspiration (optional)</span>

          <div class="flex flex-wrap gap-3">
            <input
              id="inspiration"
              name="inspiration"
              type="file"
              accept={FILE_ACCEPT}
              multiple
              aria-describedby="file-hint inspiration-error"
              class="peer sr-only"
            />

            <!-- Preview cards are rendered here by the script -->
            <ul id="file-previews" role="list" class="contents"></ul>

            <!-- The "+" card, hidden by the script once the max is reached -->
            <label
              id="file-add"
              for="inspiration"
              class="flex h-28 w-28 cursor-pointer flex-col items-center justify-center gap-1 rounded-lg border-2 border-dashed border-neutral-300 bg-white text-neutral-500 transition-colors hover:border-primary hover:text-primary peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-primary peer-aria-invalid:border-red-500"
            >
              <span class="text-3xl font-light leading-none" aria-hidden="true"
                >+</span
              >
              <span class="text-xs tracking-wider">Add files</span>
            </label>
          </div>

          <p
            id="file-hint"
            class="mt-3 text-xs tracking-wider text-neutral-500"
          >
            Images, PDF, Word or text files. Up to {MAX_FILES} files, {
              MAX_FILE_SIZE / 1024 / 1024
            }MB each.
          </p>
          <p
            id="inspiration-error"
            class={errorClass}
            aria-live="polite"
            hidden
          >
          </p>
        </div>

        <div>
          <label for="details" class={labelClass}>
            Size, location or deadline (optional)
          </label>
          <input
            id="details"
            name="details"
            type="text"
            placeholder="e.g. 3m wall in Lagos, needed by March"
            aria-describedby="details-error"
            class={inputClass}
          />
          <p id="details-error" class={errorClass} aria-live="polite" hidden>
          </p>
        </div>

        <button
          type="submit"
          data-submit
          class="w-full cursor-pointer rounded-lg bg-primary px-10 py-3 font-medium tracking-wider text-white transition enabled:hover:opacity-90 enabled:active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-60 sm:w-fit"
        >
          send request
        </button>
      </form>
    </div>
  </section>

  <!-- FAQ -->
  <section class="content w-full px-10 py-16">
    <h2
      class="font-architects-daughter mb-12 text-center text-4xl font-bold tracking-wider sm:text-5xl"
    >
      common questions
    </h2>

    <div class="grid grid-cols-1 gap-x-16 md:grid-cols-2 md:items-start">
      {
        columns.map((column) => (
          <div class="border-b border-neutral-300">
            {column.map((item) => (
              <details class="group border-t border-neutral-300">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-6 tracking-widest focus-visible:outline-2 focus-visible:outline-primary [&::-webkit-details-marker]:hidden">
                  <span>{item.q}</span>
                  <span
                    class="text-2xl font-light leading-none transition-transform duration-300 group-open:rotate-45"
                    aria-hidden="true"
                  >
                    +
                  </span>
                </summary>
                <p class="pb-6 pr-10 font-light leading-relaxed tracking-wider text-neutral-600">
                  {item.a}
                </p>
              </details>
            ))}
          </div>
        ))
      }
    </div>
  </section>
</Layout>

<script>
  import { toast } from "@/lib/toast";
  import {
    commissionSchema,
    isAcceptedFile,
    MAX_FILES,
    MAX_FILE_SIZE,
  } from "schemas/commissionSchema";

  type FieldName = keyof typeof commissionSchema.shape;

  const MAX_MB = MAX_FILE_SIZE / 1024 / 1024;
  const DOC_ICON = `<svg xmlns="http://www.w3.org/2000/svg" class="size-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" /></svg>`;

  const form = document.querySelector<HTMLFormElement>(
    "[data-commission-form]",
  );
  const submitBtn = document.querySelector<HTMLButtonElement>("[data-submit]");
  const fileInput = document.querySelector<HTMLInputElement>("#inspiration");
  const previews = document.querySelector<HTMLElement>("#file-previews");
  const addTile = document.querySelector<HTMLElement>("#file-add");

  if (form && submitBtn && fileInput && previews && addTile) {
    init(form, submitBtn, fileInput, previews, addTile);
  }

  function init(
    form: HTMLFormElement,
    submitBtn: HTMLButtonElement,
    fileInput: HTMLInputElement,
    previews: HTMLElement,
    addTile: HTMLElement,
  ) {
    const names = Object.keys(commissionSchema.shape) as FieldName[];
    const isField = (n: string): n is FieldName =>
      (names as string[]).includes(n);
    const touched = new Set<FieldName>();

    // Source of truth for uploads; the input's FileList is kept in sync with it
    const files: File[] = [];
    const previewUrls = new Map<File, string>();
    const fileKey = (f: File) => `${f.name}:${f.size}:${f.lastModified}`;

    // ---------- Validation ----------

    // Radios and files don't map cleanly to FormData, so read each value explicitly
    function getValue(name: FieldName): unknown {
      if (name === "type") {
        return form.querySelector<HTMLInputElement>(
          'input[name="type"]:checked',
        )?.value;
      }
      if (name === "inspiration") return [...files];
      return form.querySelector<HTMLInputElement | HTMLTextAreaElement>(
        `#${name}`,
      )!.value;
    }

    function getAllValues() {
      return Object.fromEntries(names.map((n) => [n, getValue(n)]));
    }

    function setError(name: FieldName, message?: string) {
      const target = form.querySelector<HTMLElement>(`#${name}`)!;
      const errorEl = form.querySelector<HTMLElement>(`#${name}-error`)!;
      if (message) {
        target.setAttribute("aria-invalid", "true");
        errorEl.textContent = message;
        errorEl.hidden = false;
      } else {
        target.removeAttribute("aria-invalid");
        errorEl.textContent = "";
        errorEl.hidden = true;
      }
    }

    function validateField(name: FieldName): boolean {
      const result = commissionSchema.shape[name].safeParse(getValue(name));
      setError(
        name,
        result.success ? undefined : result.error.issues[0].message,
      );
      return result.success;
    }

    // Silent check: no messages, just drives the button
    function updateSubmitState() {
      submitBtn.disabled = !commissionSchema.safeParse(getAllValues()).success;
    }

    function focusField(name: FieldName) {
      const el =
        name === "type"
          ? form.querySelector<HTMLInputElement>('input[name="type"]')
          : form.querySelector<HTMLElement>(`#${name}`);
      el?.focus();
    }

    // ---------- File previews ----------

    function previewUrl(file: File) {
      let url = previewUrls.get(file);
      if (!url) {
        url = URL.createObjectURL(file);
        previewUrls.set(file, url);
      }
      return url;
    }

    // Push our array back into the real input so the files get submitted
    function syncInput() {
      const dt = new DataTransfer();
      files.forEach((f) => dt.items.add(f));
      fileInput.files = dt.files;
    }

    function createCard(file: File): HTMLLIElement {
      const li = document.createElement("li");
      li.className =
        "relative h-28 w-28 overflow-hidden rounded-lg border border-neutral-300 bg-white";
      li.title = file.name;

      if (file.type.startsWith("image/")) {
        const img = document.createElement("img");
        img.src = previewUrl(file);
        img.alt = file.name;
        img.className = "h-full w-full object-cover";
        li.append(img);
      } else {
        const doc = document.createElement("div");
        doc.className =
          "flex h-full w-full flex-col items-center justify-center gap-1 px-2 text-neutral-500";
        doc.innerHTML = DOC_ICON; // static markup, no user input

        const ext = document.createElement("span");
        ext.className = "text-[10px] font-medium uppercase tracking-wider";
        ext.textContent = file.name.includes(".")
          ? file.name.split(".").pop()!
          : "file";

        const name = document.createElement("span");
        name.className =
          "w-full truncate text-center text-[11px] tracking-wider";
        name.textContent = file.name;

        doc.append(ext, name);
        li.append(doc);
      }

      const remove = document.createElement("button");
      remove.type = "button";
      remove.setAttribute("aria-label", `Remove ${file.name}`);
      remove.className =
        "absolute right-1 top-1 flex size-6 cursor-pointer items-center justify-center rounded-full bg-black/70 text-sm leading-none text-white transition hover:bg-black focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary";
      remove.innerHTML = '<span aria-hidden="true">×</span>';
      remove.addEventListener("click", () => removeFile(file));
      li.append(remove);

      return li;
    }

    function renderFiles() {
      previews.replaceChildren(...files.map(createCard));

      // Conditionally render the "+" card
      const full = files.length >= MAX_FILES;
      addTile.style.display = full ? "none" : "";
      // Don't leave an invisible input in the tab order when full
      // (never `disabled` it, since disabled inputs aren't submitted)
      fileInput.tabIndex = full ? -1 : 0;
    }

    function addFiles(incoming: File[]) {
      let error = "";

      for (const file of incoming) {
        if (files.some((f) => fileKey(f) === fileKey(file))) continue; // duplicate
        if (!isAcceptedFile(file)) {
          error ||= `"${file.name}" isn't a supported file type`;
          toast.error(error)
          continue;
        }
        if (file.size > MAX_FILE_SIZE) {
          error ||= `"${file.name}" is over ${MAX_MB}MB`;
          toast.error(error)
          continue;
        }
        if (files.length >= MAX_FILES) {
          error ||= `You can add up to ${MAX_FILES} files`;
          toast.error(error)
          continue;
        }
        files.push(file);
      }

      syncInput();
      renderFiles();
      touched.add("inspiration");
      validateField("inspiration");
      if (error) setError("inspiration", error); // show why a file was skipped
      updateSubmitState();
    }

    function removeFile(file: File) {
      files.splice(files.indexOf(file), 1);

      const url = previewUrls.get(file);
      if (url) URL.revokeObjectURL(url);
      previewUrls.delete(file);

      syncInput();
      renderFiles();
      touched.add("inspiration");
      validateField("inspiration");
      updateSubmitState();
      fileInput.focus(); // the removed card's button is gone, so keep focus nearby
    }

    // ---------- Events ----------

    // Text fields: validate on blur, then live while typing
    form.addEventListener("focusout", (e) => {
      const el = e.target as HTMLInputElement;
      if (!isField(el.name) || el.type === "radio" || el.type === "file")
        return;
      touched.add(el.name);
      validateField(el.name);
    });

    form.addEventListener("input", (e) => {
      const el = e.target as HTMLInputElement;
      if (!isField(el.name) || el.type === "file") return; // files handled on change
      if (touched.has(el.name)) validateField(el.name);
      updateSubmitState();
    });

    form.addEventListener("change", (e) => {
      const el = e.target as HTMLInputElement;
      if (!isField(el.name)) return;

      if (el.type === "file") {
        // The picker replaces the input's files, so merge the picks into our list.
        // (If the dialog was cancelled, this is empty and syncInput restores the input.)
        addFiles(Array.from(fileInput.files ?? []));
        return;
      }

      if (el.type === "radio") touched.add(el.name);
      if (touched.has(el.name)) validateField(el.name);
      updateSubmitState();
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      let firstInvalid: FieldName | null = null;
      for (const name of names) {
        touched.add(name);
        if (!validateField(name) && !firstInvalid) firstInvalid = name;
      }
      if (firstInvalid) return focusField(firstInvalid);

      submitBtn.disabled = true;

      try {
        const res = await fetch("/api/commissions", {
          method: "POST",
          body: new FormData(form),
        });
        const data = await res.json().catch(() => ({}));

        if (res.ok) {
          toast.success("Request received! I'll reply by email soon.");
          form.reset();
          files.length = 0;
          previewUrls.forEach((url) => URL.revokeObjectURL(url));
          previewUrls.clear();
          syncInput();
          renderFiles();
          touched.clear();
        } else {
          toast.error(data.error ?? "Something went wrong.");
        }
      } catch {
        toast.error("Network error. Please try again.");
      } finally {
        updateSubmitState();
      }
    });

    // Clicking a type card preselects it in the form
    document.querySelectorAll<HTMLElement>("[data-pick]").forEach((card) => {
      card.addEventListener("click", () => {
        const radio = form.querySelector<HTMLInputElement>(
          `input[name="type"][value="${card.dataset.pick}"]`,
        );
        if (!radio) return;
        radio.checked = true;
        radio.dispatchEvent(new Event("change", { bubbles: true }));
      });
    });

    // Initial state, and when the browser restores the page on back/forward
    renderFiles();
    updateSubmitState();
    window.addEventListener("pageshow", updateSubmitState);
  }
</script>
