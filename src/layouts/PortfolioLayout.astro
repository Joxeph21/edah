---
import PortfolioFooter from "@/components/PortfolioFooter.astro";
import Layout from "@/layouts/Layout.astro";

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article" | "product";
  noIndex?: boolean;
  noFollow?: boolean;
  tags?: string[];
}
const { title, description, type = "website", noIndex = false, noFollow = false, tags } = Astro.props;
---

<Layout
  title={title}
  description={description}
  type={type}
  noIndex={noIndex}
  noFollow={noFollow}
  tags={tags}
>
  <section class="content gap-8 px-6 md:px-10">
    <nav class="flex-between">
      <a
        href="/portfolio"
        class="flex-center w-fit gap-2 text-sm sm:text-base md:text-lg font-architects-daughter font-semibold tracking-widest underline underline-offset-4"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="1em"
          height="1em"
          viewBox="0 0 512 512"
        >
          <path d="M0 0h512v512H0z" fill="none"></path>
          <path
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="32"
            d="m112 160l-64 64l64 64"></path>
          <path
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="32"
            d="M64 224h294c58.76 0 106 49.33 106 108v20"></path>
        </svg>

        Back</a
      >

      <a
        href="/shop"
        class="flex-center w-fit gap-2 text-sm sm:text-base md:text-lg font-architects-daughter font-semibold tracking-widest underline underline-offset-4"
      >
        See what&apos;s available in store</a
      >
    </nav>
    <section class="w-full flex flex-col min-h-52">
      <slot />
    </section>
    <PortfolioFooter />
  </section>
</Layout>
