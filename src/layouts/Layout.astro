---
import { BIO } from "@/constants";
import Footer from "@/components/Layout/Footer.astro";
import Header from "@/components/Layout/Header.astro";
import SmoothScroll from "@/components/SmoothScroll.astro";
import "@/styles/global.css";
import { Font } from "astro:assets";

import { ClientRouter, fade } from "astro:transitions";
import Toaster from "@/ui/Toaster.astro";
import { getSEOMeta, getStructuredData } from "@/lib/seo";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article" | "product";
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  section?: string;
  tags?: string[];
  price?: number;
  currency?: string;
  availability?: "in_stock" | "out_of_stock" | "pre_order";
  noIndex?: boolean;
  noFollow?: boolean;
}

const {
  title,
  description = BIO.bio.slice(0, 350) + "...",
  image = "/og-image.png",
  type = "website",
  publishedTime,
  modifiedTime,
  author,
  section,
  tags,
  price,
  currency,
  availability,
  noIndex = false,
  noFollow = false,
} = Astro.props;

const { metaTags, fullTitle, canonicalURL } = getSEOMeta({
  title,
  description,
  image,
  url: Astro.url.pathname,
  type,
  publishedTime,
  modifiedTime,
  author,
  section,
  tags,
  price,
  currency,
  availability,
  noIndex,
  noFollow,
});

const structuredData = getStructuredData({
  title,
  description,
  image,
  url: Astro.url.pathname,
  type,
  publishedTime,
  modifiedTime,
  author,
  section,
  tags,
  price,
  currency,
  availability,
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.ico" />
    <Font cssVariable="--font-architects-daughter" preload />
    <Font cssVariable="--font-biryani" preload />

    <title>{fullTitle}</title>
    <link rel="canonical" href={canonicalURL} />

    {metaTags.map((tag) => (
      tag.name ? (
        <meta name={tag.name} content={tag.content} />
      ) : (
        <meta property={tag.property} content={tag.content} />
      )
    ))}

    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    ></script>

    <ClientRouter />
  </head>
  <body
    id="top"
    class="w-full items-center relative bg-background min-h-screen h-full flex flex-col"
  >
    <Toaster />
    <SmoothScroll />
    <Header />

    <main
      class="w-full max-w-[1920px] mx-auto"
      transition:animate={fade({ duration: "0.3s" })}
    >
      <slot />
    </main>

    <Footer />
  </body>
</html>
