---
// src/components/LegalLayout.astro
import Layout from "@/layouts/Layout.astro";
import { LEGAL } from "@/data/legal";

interface Props {
  title: string;
}
const { title } = Astro.props;

const hasPlaceholders = Object.values(LEGAL).some(
  (v) => typeof v === "string" && v.includes("[")
);

const path = Astro.url.pathname.replace(/\/$/, "");
const policies = [
  { href: "/terms", label: "Terms of Service" },
  { href: "/refund-policy", label: "Refund & Returns Policy" },
  { href: "/privacy-policy", label: "Privacy Policy" },
].filter((p) => p.href !== path);
---

<Layout title={title}>
  <article class="mx-auto w-full max-w-3xl px-6 py-16 md:px-10 md:py-24">
    {
      import.meta.env.DEV && hasPlaceholders && (
        <div
          role="note"
          class="mb-10 rounded-2xl border border-amber-300 bg-amber-50 p-4 text-sm leading-6 text-amber-900"
        >
          <strong>Draft.</strong> Replace every [bracketed] value in
          <code> src/data/legal.ts</code> and have the text reviewed by a
          lawyer before publishing. This banner only appears in development.
        </div>
      )
    }

    <header class="mb-12">
      <p class="text-xs uppercase tracking-[0.3em] text-neutral-500">legal</p>
      <h1 class="mt-3 text-4xl lowercase tracking-widest text-[#6b5252] md:text-5xl">
        {title}
      </h1>
      <span class="my-6 block h-px w-12 bg-[#6b5252]"></span>
      <p class="text-sm text-neutral-500">Last updated: {LEGAL.updated}</p>
    </header>

    <div
      class="text-base leading-8 tracking-wide text-neutral-700
        [&_h2]:mb-4 [&_h2]:mt-12 [&_h2]:font-architects-daughter [&_h2]:text-2xl [&_h2]:tracking-wider [&_h2]:text-[#6b5252]
        [&_h3]:mb-2 [&_h3]:mt-8 [&_h3]:text-lg [&_h3]:font-semibold [&_h3]:text-neutral-900
        [&_p]:mb-4
        [&_ul]:mb-4 [&_ul]:list-disc [&_ul]:pl-6 [&_li]:mb-2
        [&_a]:text-[#6b5252] [&_a]:underline [&_a]:underline-offset-4 hover:[&_a]:opacity-70
        [&_strong]:font-semibold [&_strong]:text-neutral-900
        [&_table]:w-full [&_table]:text-sm [&_th]:p-3 [&_th]:text-left [&_th]:font-semibold
        [&_td]:p-3 [&_td]:align-top [&_tr]:border-b [&_tr]:border-neutral-200"
    >
      <slot />
    </div>

    <nav aria-label="Other policies" class="mt-16 border-t border-neutral-300 pt-8">
      <p class="mb-3 text-xs uppercase tracking-[0.3em] text-neutral-500">
        also read
      </p>
      <ul class="flex flex-wrap gap-x-8 gap-y-2 text-sm">
        {
          policies.map((p) => (
            <li>
              <a href={p.href} class="underline underline-offset-4 hover:opacity-70">
                {p.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </article>
</Layout>